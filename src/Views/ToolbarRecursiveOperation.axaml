<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="420"
             x:Class="SourceGit.Views.ToolbarRecursiveOperation"
             x:Name="ThisControl"
             x:DataType="vm:ToolbarRecursiveOperation">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
        Margin="8,0">
    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          IsVisible="{Binding ShowEmbeddedHeader}">
      <TextBlock Grid.Column="0"
                 FontSize="18"
                 Classes="bold"
                 Text="{Binding Title}"/>

      <Button Grid.Column="1"
              Classes="icon_button"
              Width="24"
              Height="24"
              Click="OnManualClose"
              ToolTip.Tip="{DynamicResource Text.Close}">
        <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
      </Button>
    </Grid>

    <TextBlock Grid.Row="1"
               Margin="0,6,0,0"
               Foreground="{DynamicResource Brush.FG2}"
               FontStyle="Italic"
               Text="{Binding Description}"/>

    <Border Grid.Row="2"
            Margin="0,10,0,0"
            Padding="10,8"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="False"/>

    <Border Grid.Row="3"
            Margin="0,12,0,0"
            Padding="12,8"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsOperationSummaryVisible}">
      <Grid RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="4"
            VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{Binding OperationSummaryTitle}"/>

        <Border Grid.Column="1"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="{DynamicResource Brush.Popup}">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding OperationSummaryTotalText}"/>
        </Border>

        <Border Grid.Column="2"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#142F855A"
                BorderBrush="#662F855A"
                BorderThickness="1">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF2F855A"
                     Text="{Binding OperationSummarySucceededText}"/>
        </Border>

        <ItemsControl Grid.Column="2"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding OperationSummarySucceededDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FF2F855A"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="3"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#141D6FDD"
                BorderBrush="#661D6FDD"
                BorderThickness="1">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF1D6FDD"
                     Text="{Binding OperationSummarySkippedByUserText}"/>
        </Border>

        <ItemsControl Grid.Column="3"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding OperationSummarySkippedByUserDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FF1D6FDD"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="4"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#14B7791F"
                BorderBrush="#66B7791F"
                BorderThickness="1">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF8A5A12"
                     Text="{Binding OperationSummarySkippedAutomaticallyText}"/>
        </Border>

        <ItemsControl Grid.Column="4"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding OperationSummarySkippedAutomaticallyDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FFB7791F"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="5"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#143B82F6"
                BorderBrush="#663B82F6"
                BorderThickness="1"
                IsVisible="{Binding IsNotInitializedSummaryVisible}">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF2563EB"
                     Text="{Binding OperationSummarySkippedNotInitializedText}"/>
        </Border>

        <ItemsControl Grid.Column="5"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      IsVisible="{Binding IsNotInitializedSummaryVisible}"
                      ItemsSource="{Binding OperationSummarySkippedNotInitializedDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FF3B82F6"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="6"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#14B91C1C"
                BorderBrush="#66B91C1C"
                BorderThickness="1">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FFB91C1C"
                     Text="{Binding OperationSummaryFailedText}"/>
        </Border>

        <ItemsControl Grid.Column="6"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding OperationSummaryFailedDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FFB91C1C"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Grid.RowSpan="{Binding SubmoduleBoardRowSpan}"
            Margin="0,12,0,0"
            Padding="14,12"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsSubmoduleProgressBoardVisible}">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8"
              IsVisible="{Binding CanEditSubmoduleSelection}">
          <StackPanel Grid.Column="0"
                      Orientation="Vertical"
                      Spacing="4">
            <TextBlock FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG1}"
                       Text="Select submodules to update recursively"/>
            <TextBlock Foreground="{DynamicResource Brush.FG2}"
                       Text="Selection is remembered for this repository."/>
          </StackPanel>

          <Button Grid.Column="1"
                  Classes="flat"
                  Padding="8,2"
                  VerticalAlignment="Top"
                  Click="OnSelectAllSubmodules">
            <TextBlock Text="Select all"/>
          </Button>

          <Button Grid.Column="2"
                  Classes="flat"
                  Padding="8,2"
                  VerticalAlignment="Top"
                  Click="OnClearSubmoduleSelection">
            <TextBlock Text="Clear all"/>
          </Button>
        </Grid>

        <Border Grid.Row="0"
                Padding="12,10"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border1}"
                Background="{DynamicResource Brush.Popup}"
                CornerRadius="12"
                IsVisible="{Binding IsCombinedSyncPhaseVisible}">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsCombinedSyncPhaseVisible"/>
              <Binding Path="CanEditSubmoduleSelection" Converter="{x:Static BoolConverters.Not}"/>
            </MultiBinding>
          </Border.IsVisible>
          <Grid RowDefinitions="Auto,Auto"
                ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                HorizontalAlignment="Center">
            <Border Padding="12,5"
                    Grid.Row="0"
                    Grid.Column="0"
                    CornerRadius="999"
                    BorderThickness="1"
                    Opacity="{Binding PullPhaseOpacity}"
                    Background="{Binding PullPhaseBackground}"
                    BorderBrush="{Binding PullPhaseBorderBrush}">
              <TextBlock FontWeight="SemiBold"
                         Foreground="{Binding PullPhaseForeground}"
                         Text="Pull"/>
            </Border>

            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text=">"/>

            <Border Padding="12,5"
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="270"
                    CornerRadius="999"
                    BorderThickness="1"
                    Opacity="{Binding UpdateSubmodulesPhaseOpacity}"
                    Background="{Binding UpdateSubmodulesPhaseBackground}"
                    BorderBrush="{Binding UpdateSubmodulesPhaseBorderBrush}">
              <TextBlock FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         Foreground="{Binding UpdateSubmodulesPhaseForeground}"
                         Text="Update Submodules"/>
            </Border>

            <TextBlock Grid.Row="0"
                       Grid.Column="3"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text=">"/>

            <Border Padding="12,5"
                    Grid.Row="0"
                    Grid.Column="4"
                    CornerRadius="999"
                    BorderThickness="1"
                    Opacity="{Binding FetchAndPrunePhaseOpacity}"
                    Background="{Binding FetchAndPrunePhaseBackground}"
                    BorderBrush="{Binding FetchAndPrunePhaseBorderBrush}">
              <TextBlock FontWeight="SemiBold"
                         Foreground="{Binding FetchAndPrunePhaseForeground}"
                         Text="Fetch + Prune"/>
            </Border>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{Binding PullPhaseStatusForeground}"
                       Text="{Binding PullPhaseStatusText}"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{Binding UpdateSubmodulesPhaseStatusForeground}"
                       Text="{Binding UpdateSubmodulesPhaseStatusText}"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="4"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{Binding FetchAndPrunePhaseStatusForeground}"
                       Text="{Binding FetchAndPrunePhaseStatusText}"/>
          </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,12,0,0"
              ColumnDefinitions="*,Auto"
              IsVisible="{Binding IsCombinedSyncPhaseVisible, Converter={x:Static BoolConverters.Not}}">
          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="Selected submodules"/>

          <Border Grid.Column="1"
                  Padding="10,3"
                  CornerRadius="999"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  Background="{DynamicResource Brush.Popup}"
                  IsVisible="{Binding CurrentSubmoduleProgressText, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="CurrentSubmoduleProgressText" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
                <Binding Path="CanEditSubmoduleSelection" Converter="{x:Static BoolConverters.Not}"/>
              </MultiBinding>
            </Border.IsVisible>
            <TextBlock FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding CurrentSubmoduleProgressText}"/>
          </Border>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Margin="0,8,0,0"
                      MaxHeight="{Binding SubmoduleBoardMaxHeight}"
                      Classes="static_scrollbar"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding CanEditSubmoduleSelection}">
          <ItemsControl ItemsSource="{Binding SubmoduleRunItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"
                           ItemWidth="492"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,8,3"
                        Padding="7,2"
                        Width="492"
                        CornerRadius="9"
                        BorderThickness="1"
                        Background="{Binding RowBackground}"
                        BorderBrush="{Binding RowBorderBrush}">
                  <Grid MinHeight="22"
                        ColumnDefinitions="18,*"
                        ColumnSpacing="7">
                    <CheckBox Width="15"
                              Height="15"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding #ThisControl.DataContext.CanEditSubmoduleSelection}"/>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding PathForeground}"
                               Text="{Binding Path}"
                               TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2"
                      Margin="0,8,0,0"
                      MaxHeight="{Binding SubmoduleBoardMaxHeight}"
                      Classes="static_scrollbar"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.IsVisible>
            <Binding Path="CanEditSubmoduleSelection" Converter="{x:Static BoolConverters.Not}"/>
          </ScrollViewer.IsVisible>
          <ItemsControl ItemsSource="{Binding SubmoduleRunItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"
                           ItemWidth="492"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,8,4"
                        Padding="7,2"
                        Width="492"
                        CornerRadius="9"
                        BorderThickness="1"
                        Background="{Binding RowBackground}"
                        BorderBrush="{Binding RowBorderBrush}">
                  <Grid MinHeight="24"
                        ColumnDefinitions="18,*,Auto"
                        ColumnSpacing="7">
                    <CheckBox Width="15"
                              Height="15"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding #ThisControl.DataContext.CanEditSubmoduleSelection}"/>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding PathForeground}"
                               Text="{Binding Path}"
                               TextTrimming="CharacterEllipsis"/>

                    <Grid Grid.Column="2"
                          ColumnDefinitions="140,Auto"
                          ColumnSpacing="6"
                          VerticalAlignment="Center">
                      <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsRunning"/>
                          <Binding Path="#ThisControl.DataContext.AreSubmoduleStatusesVisible"/>
                        </MultiBinding>
                      </Grid.IsVisible>

                      <ProgressBar Grid.Column="0"
                                   Height="5"
                                   Maximum="100"
                                   MinWidth="96"
                                   IsIndeterminate="True"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Background="{DynamicResource Brush.Border1}"/>

                      <Path Grid.Column="1"
                            Width="14"
                            Height="14"
                            Margin="0,0,2,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource Icons.Loading}"
                            Fill="{Binding RunningIndicatorBrush}"/>
                    </Grid>

                    <Button Grid.Column="2"
                            MinWidth="108"
                            Padding="10,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            CornerRadius="999"
                            BorderThickness="1"
                            Background="{Binding StatusBackground}"
                            BorderBrush="{Binding StatusBorderBrush}"
                            ToolTip.Tip="{Binding StatusToolTip}"
                            Click="OnOpenSubmoduleUpdateDiff">
                      <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="CanOpenUpdateDiff"/>
                          <Binding Path="#ThisControl.DataContext.AreSubmoduleStatusesVisible"/>
                        </MultiBinding>
                      </Button.IsVisible>
                      <TextBlock HorizontalAlignment="Center"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding StatusForeground}"
                                 Text="{Binding StatusText}"/>
                    </Button>

                    <Border Grid.Column="2"
                            MinWidth="108"
                            Padding="10,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            CornerRadius="999"
                            BorderThickness="1"
                            Background="{Binding StatusBackground}"
                            BorderBrush="{Binding StatusBorderBrush}">
                      <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsReadOnlyStatusVisible"/>
                          <Binding Path="#ThisControl.DataContext.AreSubmoduleStatusesVisible"/>
                        </MultiBinding>
                      </Border.IsVisible>
                      <TextBlock HorizontalAlignment="Center"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding StatusForeground}"
                                 Text="{Binding StatusText}"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="5"
          Margin="0,10,0,0"
          ColumnDefinitions="Auto,*"
          IsVisible="{Binding AreOperationButtonsVisible}">
      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">
        <CheckBox VerticalAlignment="Center"
                  Content="Pin window"
                  IsChecked="{Binding KeepWindowOpen, Mode=TwoWay}"/>

        <Border Padding="10,3"
                CornerRadius="999"
                BorderThickness="1"
                Background="{Binding FetchModeBackground}"
                BorderBrush="{Binding FetchModeBorderBrush}"
                IsVisible="{Binding IsFetchModeIndicatorVisible}">
          <TextBlock FontSize="12"
                     FontWeight="Bold"
                     Foreground="{Binding FetchModeForeground}"
                     Text="{Binding FetchModeText}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
      <Button Classes="flat primary"
              Height="28"
              Padding="10,0"
              Cursor="Hand"
              Content="Cancel"
              Click="OnCancelOperation"
              IsEnabled="{Binding CanCancelOperation}"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Copy current command"
              Click="OnCopyCurrentCommand"
              IsEnabled="{Binding Log.LatestCommand, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Close immediately"
              Click="OnCloseImmediately"
              IsVisible="{Binding CanStopCountdown, Converter={x:Static BoolConverters.Not}}"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Copy message"
              Click="OnCopyMessage"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="4"
            Margin="0,12,0,0"
            Padding="12,10"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsLegacyCombinedSyncPhaseVisible}">
      <Grid RowDefinitions="Auto,Auto,Auto"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
            HorizontalAlignment="Center">
          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="0"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding PullPhaseOpacity}"
                  Background="{Binding PullPhaseBackground}"
                  BorderBrush="{Binding PullPhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{Binding PullPhaseForeground}"
                       Text="Pull"/>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="1"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text=">"/>

          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="2"
                  Width="270"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding UpdateSubmodulesPhaseOpacity}"
                  Background="{Binding UpdateSubmodulesPhaseBackground}"
                  BorderBrush="{Binding UpdateSubmodulesPhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{Binding UpdateSubmodulesPhaseForeground}"
                       Text="Update Submodules"/>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="3"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text=">"/>

          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="4"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding FetchAndPrunePhaseOpacity}"
                  Background="{Binding FetchAndPrunePhaseBackground}"
                  BorderBrush="{Binding FetchAndPrunePhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{Binding FetchAndPrunePhaseForeground}"
                       Text="Fetch + Prune"/>
          </Border>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{Binding PullPhaseStatusForeground}"
                   Text="{Binding PullPhaseStatusText}"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{Binding UpdateSubmodulesPhaseStatusForeground}"
                   Text="{Binding UpdateSubmodulesPhaseStatusText}"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="4"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{Binding FetchAndPrunePhaseStatusForeground}"
                   Text="{Binding FetchAndPrunePhaseStatusText}"/>

        <Grid Margin="0,10,0,0"
              Grid.Row="2"
              Grid.Column="2"
              ColumnDefinitions="*,Auto"
              HorizontalAlignment="Center"
              IsVisible="{Binding IsSubmodulePhaseDetailsVisible}">
          <TextBlock Grid.Column="0"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Text="{Binding CurrentSubmoduleName}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.FG1}"/>

          <Border Grid.Column="1"
                  Margin="12,0,0,0"
                  Padding="10,3"
                  CornerRadius="999"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  Background="{DynamicResource Brush.Popup}">
            <TextBlock FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding CurrentSubmoduleProgressText}"/>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Margin="0,12,0,0"
            Padding="12,10"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsLegacySingleOperationSubmoduleProgressVisible}">
      <Grid ColumnDefinitions="*,Auto"
            HorizontalAlignment="Center">
        <TextBlock Grid.Column="0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Text="{Binding CurrentSubmoduleName}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.FG1}"/>

        <Border Grid.Column="1"
                Margin="12,0,0,0"
                Padding="10,3"
                CornerRadius="999"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border1}"
                Background="{DynamicResource Brush.Popup}">
          <TextBlock FontSize="12"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding CurrentSubmoduleProgressText}"/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="6"
            Margin="0,12,0,0"
            MinHeight="180"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsLogVisible}">
      <v:CommandLogContentPresenter Log="{Binding Log}"/>
    </Border>
  </Grid>
</UserControl>
