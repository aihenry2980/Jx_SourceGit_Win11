<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="420"
             x:Class="SourceGit.Views.ToolbarRecursiveOperation"
             x:DataType="vm:ToolbarRecursiveOperation">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <Grid ColumnDefinitions="*,Auto"
          IsVisible="{Binding ShowEmbeddedHeader}">
      <TextBlock Grid.Column="0"
                 FontSize="18"
                 Classes="bold"
                 Text="{Binding Title}"/>

      <Button Grid.Column="1"
              Classes="icon_button"
              Width="24"
              Height="24"
              Click="OnManualClose"
              ToolTip.Tip="{DynamicResource Text.Close}">
        <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
      </Button>
    </Grid>

    <TextBlock Margin="0,6,0,0"
               Foreground="{DynamicResource Brush.FG2}"
               FontStyle="Italic"
               Text="{Binding Description}"/>

    <Border Margin="0,10,0,0"
            Padding="10,8"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsSubmoduleSelectionVisible}">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsSubmoduleSelectionVisible"/>
          <Binding Path="InProgress" Converter="{x:Static BoolConverters.Not}"/>
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel Orientation="Vertical">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Text="Select submodules to update recursively"/>
          <Button Grid.Column="1"
                  Classes="flat"
                  Padding="8,2"
                  Click="OnSelectAllSubmodules">
            <TextBlock Text="Select all"/>
          </Button>
          <Button Grid.Column="2"
                  Classes="flat"
                  Margin="8,0,0,0"
                  Padding="8,2"
                  Click="OnClearSubmoduleSelection">
            <TextBlock Text="Clear all"/>
          </Button>
        </Grid>

        <TextBlock Margin="0,6,0,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="Selection is remembered for this repository."/>

        <ScrollViewer Margin="0,8,0,0"
                      Height="250"
                      MaxHeight="250"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasSubmodulesToSelect}">
          <ItemsControl ItemsSource="{Binding SubmoduleSelections}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="0,0,16,0"
                          MinHeight="24"
                          Height="24"
                          Padding="0"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          Content="{Binding Path}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   IsVisible="{Binding HasSubmodulesToSelect, Converter={x:Static BoolConverters.Not}}"
                   Text="No submodules found in this repository."/>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" IsVisible="{Binding AreOperationButtonsVisible}">
      <Button Classes="flat primary"
              Height="28"
              Padding="10,0"
              Cursor="Hand"
              Content="Cancel"
              Click="OnCancelOperation"
              IsEnabled="{Binding CanCancelOperation}"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Close immediately"
              Click="OnCloseImmediately"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Copy message"
              Click="OnCopyMessage"/>
    </StackPanel>

    <Border Margin="0,12,0,0"
            Padding="12,10"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsCombinedSyncPhaseVisible}">
      <Grid RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
            HorizontalAlignment="Center">
          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="0"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding PullPhaseOpacity}"
                  Background="{Binding PullPhaseBackground}"
                  BorderBrush="{Binding PullPhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{Binding PullPhaseForeground}"
                       Text="Pull"/>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="1"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text=">"/>

          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="2"
                  Width="270"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding UpdateSubmodulesPhaseOpacity}"
                  Background="{Binding UpdateSubmodulesPhaseBackground}"
                  BorderBrush="{Binding UpdateSubmodulesPhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{Binding UpdateSubmodulesPhaseForeground}"
                       Text="Update Submodules"/>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="3"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text=">"/>

          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="4"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding FetchAndPrunePhaseOpacity}"
                  Background="{Binding FetchAndPrunePhaseBackground}"
                  BorderBrush="{Binding FetchAndPrunePhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{Binding FetchAndPrunePhaseForeground}"
                       Text="Fetch + Prune"/>
          </Border>
        <Grid Margin="0,10,0,0"
              Grid.Row="1"
              Grid.Column="2"
              ColumnDefinitions="*,Auto"
              HorizontalAlignment="Center"
              IsVisible="{Binding IsSubmodulePhaseDetailsVisible}">
          <TextBlock Grid.Column="0"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Text="{Binding CurrentSubmoduleName}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.FG1}"/>

          <Border Grid.Column="1"
                  Margin="12,0,0,0"
                  Padding="10,3"
                  CornerRadius="999"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  Background="{DynamicResource Brush.Popup}">
            <TextBlock FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding CurrentSubmoduleProgressText}"/>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border Margin="0,12,0,0"
            Padding="12,10"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsSingleOperationSubmoduleProgressVisible}">
      <Grid ColumnDefinitions="*,Auto"
            HorizontalAlignment="Center">
        <TextBlock Grid.Column="0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Text="{Binding CurrentSubmoduleName}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.FG1}"/>

        <Border Grid.Column="1"
                Margin="12,0,0,0"
                Padding="10,3"
                CornerRadius="999"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border1}"
                Background="{DynamicResource Brush.Popup}">
          <TextBlock FontSize="12"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding CurrentSubmoduleProgressText}"/>
        </Border>
      </Grid>
    </Border>

    <Border Margin="0,12,0,0"
            Height="180"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsLogVisible}">
      <v:CommandLogContentPresenter Log="{Binding Log}"/>
    </Border>
  </StackPanel>
</UserControl>
