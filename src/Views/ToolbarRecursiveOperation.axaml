<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="420"
             x:Class="SourceGit.Views.ToolbarRecursiveOperation"
             x:DataType="vm:ToolbarRecursiveOperation">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
        Margin="8,0">
    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          IsVisible="{Binding ShowEmbeddedHeader}">
      <TextBlock Grid.Column="0"
                 FontSize="18"
                 Classes="bold"
                 Text="{Binding Title}"/>

      <Button Grid.Column="1"
              Classes="icon_button"
              Width="24"
              Height="24"
              Click="OnManualClose"
              ToolTip.Tip="{DynamicResource Text.Close}">
        <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
      </Button>
    </Grid>

    <TextBlock Grid.Row="1"
               Margin="0,6,0,0"
               Foreground="{DynamicResource Brush.FG2}"
               FontStyle="Italic"
               Text="{Binding Description}"/>

    <Border Grid.Row="2"
            Margin="0,10,0,0"
            Padding="10,8"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsSubmoduleSelectionVisible}">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsSubmoduleSelectionVisible"/>
          <Binding Path="InProgress" Converter="{x:Static BoolConverters.Not}"/>
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel Orientation="Vertical">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Text="Select submodules to update recursively"/>
          <Button Grid.Column="1"
                  Classes="flat"
                  Padding="8,2"
                  Click="OnSelectAllSubmodules">
            <TextBlock Text="Select all"/>
          </Button>
          <Button Grid.Column="2"
                  Classes="flat"
                  Margin="8,0,0,0"
                  Padding="8,2"
                  Click="OnClearSubmoduleSelection">
            <TextBlock Text="Clear all"/>
          </Button>
        </Grid>

        <TextBlock Margin="0,6,0,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="Selection is remembered for this repository."/>

        <ListBox x:Name="SubmoduleSelectionList"
                 Margin="0,8,0,0"
                 Height="250"
                 MaxHeight="250"
                 BorderThickness="0"
                 Background="Transparent"
                 Classes="static_scrollbar"
                 ItemsSource="{Binding SubmoduleSelections}"
                 SelectedItem="{Binding SelectedSubmoduleSelection, Mode=TwoWay}"
                 SelectionMode="Single"
                 IsVisible="{Binding HasSubmodulesToSelect}"
                 KeyDown="OnSubmoduleSelectionListKeyDown"
                 ScrollViewer.AllowAutoHide="False"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0"/>
              <Setter Property="MinHeight" Value="18"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox Margin="0,0,12,0"
                        MinHeight="18"
                        Height="18"
                        Padding="0"
                        Focusable="False"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="{Binding Path}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   IsVisible="{Binding HasSubmodulesToSelect, Converter={x:Static BoolConverters.Not}}"
                   Text="No submodules found in this repository."/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3"
          Margin="0,10,0,0"
          ColumnDefinitions="Auto,*"
          IsVisible="{Binding AreOperationButtonsVisible}">
      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">
        <CheckBox VerticalAlignment="Center"
                  Content="Pin window"
                  IsChecked="{Binding KeepWindowOpen, Mode=TwoWay}"/>

        <Border Padding="10,3"
                CornerRadius="999"
                BorderThickness="1"
                Background="{Binding FetchModeBackground}"
                BorderBrush="{Binding FetchModeBorderBrush}"
                IsVisible="{Binding IsFetchModeIndicatorVisible}">
          <TextBlock FontSize="12"
                     FontWeight="Bold"
                     Foreground="{Binding FetchModeForeground}"
                     Text="{Binding FetchModeText}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
      <Button Classes="flat primary"
              Height="28"
              Padding="10,0"
              Cursor="Hand"
              Content="Cancel"
              Click="OnCancelOperation"
              IsEnabled="{Binding CanCancelOperation}"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Copy current command"
              Click="OnCopyCurrentCommand"
              IsEnabled="{Binding Log.LatestCommand, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Close immediately"
              Click="OnCloseImmediately"
              IsVisible="{Binding CanStopCountdown, Converter={x:Static BoolConverters.Not}}"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Copy message"
              Click="OnCopyMessage"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="4"
            Margin="0,12,0,0"
            Padding="12,10"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsCombinedSyncPhaseVisible}">
      <Grid RowDefinitions="Auto,Auto,Auto"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
            HorizontalAlignment="Center">
          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="0"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding PullPhaseOpacity}"
                  Background="{Binding PullPhaseBackground}"
                  BorderBrush="{Binding PullPhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{Binding PullPhaseForeground}"
                       Text="Pull"/>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="1"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text=">"/>

          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="2"
                  Width="270"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding UpdateSubmodulesPhaseOpacity}"
                  Background="{Binding UpdateSubmodulesPhaseBackground}"
                  BorderBrush="{Binding UpdateSubmodulesPhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{Binding UpdateSubmodulesPhaseForeground}"
                       Text="Update Submodules"/>
          </Border>

          <TextBlock Grid.Row="0"
                     Grid.Column="3"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text=">"/>

          <Border Padding="12,5"
                  Grid.Row="0"
                  Grid.Column="4"
                  CornerRadius="999"
                  BorderThickness="1"
                  Opacity="{Binding FetchAndPrunePhaseOpacity}"
                  Background="{Binding FetchAndPrunePhaseBackground}"
                  BorderBrush="{Binding FetchAndPrunePhaseBorderBrush}">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{Binding FetchAndPrunePhaseForeground}"
                       Text="Fetch + Prune"/>
          </Border>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{Binding PullPhaseStatusForeground}"
                   Text="{Binding PullPhaseStatusText}"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{Binding UpdateSubmodulesPhaseStatusForeground}"
                   Text="{Binding UpdateSubmodulesPhaseStatusText}"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="4"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{Binding FetchAndPrunePhaseStatusForeground}"
                   Text="{Binding FetchAndPrunePhaseStatusText}"/>

        <Grid Margin="0,10,0,0"
              Grid.Row="2"
              Grid.Column="2"
              ColumnDefinitions="*,Auto"
              HorizontalAlignment="Center"
              IsVisible="{Binding IsSubmodulePhaseDetailsVisible}">
          <TextBlock Grid.Column="0"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Text="{Binding CurrentSubmoduleName}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.FG1}"/>

          <Border Grid.Column="1"
                  Margin="12,0,0,0"
                  Padding="10,3"
                  CornerRadius="999"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  Background="{DynamicResource Brush.Popup}">
            <TextBlock FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding CurrentSubmoduleProgressText}"/>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Margin="0,12,0,0"
            Padding="12,10"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsSingleOperationSubmoduleProgressVisible}">
      <Grid ColumnDefinitions="*,Auto"
            HorizontalAlignment="Center">
        <TextBlock Grid.Column="0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Text="{Binding CurrentSubmoduleName}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.FG1}"/>

        <Border Grid.Column="1"
                Margin="12,0,0,0"
                Padding="10,3"
                CornerRadius="999"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border1}"
                Background="{DynamicResource Brush.Popup}">
          <TextBlock FontSize="12"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding CurrentSubmoduleProgressText}"/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="5"
            Margin="0,12,0,0"
            Padding="12,8"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsOperationSummaryVisible}">
      <Grid RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="4"
            VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{Binding OperationSummaryTitle}"/>

        <Border Grid.Column="1"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="{DynamicResource Brush.Popup}">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding OperationSummaryTotalText}"/>
        </Border>

        <Border Grid.Column="2"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#142F855A"
                BorderBrush="#662F855A"
                BorderThickness="1">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF2F855A"
                     Text="{Binding OperationSummarySucceededText}"/>
        </Border>

        <ItemsControl Grid.Column="2"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding OperationSummarySucceededDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FF2F855A"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="3"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#141D6FDD"
                BorderBrush="#661D6FDD"
                BorderThickness="1">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF1D6FDD"
                     Text="{Binding OperationSummarySkippedByUserText}"/>
        </Border>

        <ItemsControl Grid.Column="3"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding OperationSummarySkippedByUserDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FF1D6FDD"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="4"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#14B7791F"
                BorderBrush="#66B7791F"
                BorderThickness="1">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF8A5A12"
                     Text="{Binding OperationSummarySkippedAutomaticallyText}"/>
        </Border>

        <ItemsControl Grid.Column="4"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding OperationSummarySkippedAutomaticallyDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FFB7791F"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="5"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#143B82F6"
                BorderBrush="#663B82F6"
                BorderThickness="1"
                IsVisible="{Binding IsNotInitializedSummaryVisible}">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF2563EB"
                     Text="{Binding OperationSummarySkippedNotInitializedText}"/>
        </Border>

        <ItemsControl Grid.Column="5"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      IsVisible="{Binding IsNotInitializedSummaryVisible}"
                      ItemsSource="{Binding OperationSummarySkippedNotInitializedDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FF3B82F6"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="6"
                Grid.Row="0"
                Padding="10,3"
                CornerRadius="999"
                Background="#14B91C1C"
                BorderBrush="#66B91C1C"
                BorderThickness="1">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FFB91C1C"
                     Text="{Binding OperationSummaryFailedText}"/>
        </Border>

        <ItemsControl Grid.Column="6"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      ItemsSource="{Binding OperationSummaryFailedDots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8"
                      Height="8"
                      CornerRadius="999"
                      Background="#FFB91C1C"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Grid.Row="6"
            Margin="0,12,0,0"
            MinHeight="180"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}"
            IsVisible="{Binding IsLogVisible}">
      <v:CommandLogContentPresenter Log="{Binding Log}"/>
    </Border>
  </Grid>
</UserControl>
