<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="520"
             x:Class="SourceGit.Views.ToolbarRecursiveOperation"
             x:DataType="vm:ToolbarRecursiveOperation">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 FontSize="18"
                 Classes="bold"
                 Text="{Binding Title}"/>

      <Button Grid.Column="1"
              Classes="icon_button"
              Width="24"
              Height="24"
              Click="OnManualClose"
              ToolTip.Tip="{DynamicResource Text.Close}">
        <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
      </Button>
    </Grid>

    <TextBlock Margin="0,6,0,0"
               Foreground="{DynamicResource Brush.FG2}"
               FontStyle="Italic"
               Text="{Binding Description}"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Classes="flat primary"
              Height="28"
              Padding="10,0"
              Cursor="Hand"
              Content="Close immediately"
              Click="OnCloseImmediately"/>

      <Button Classes="flat primary"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Stop countdown"
              Click="OnStopCountdown"/>

      <Button Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="10,0"
              Cursor="Hand"
              Content="Copy message"
              Click="OnCopyMessage"/>
    </StackPanel>

    <Border Margin="0,12,0,0"
            Height="380"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}">
      <v:CommandLogContentPresenter Log="{Binding Log}"
                                    FontFamily="{DynamicResource Fonts.Monospace}"
                                    FontSize="11"/>
    </Border>
  </StackPanel>
</UserControl>
