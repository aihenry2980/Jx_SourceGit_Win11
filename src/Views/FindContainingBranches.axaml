<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    x:Class="SourceGit.Views.FindContainingBranches"
                    x:DataType="vm:FindContainingBranches"
                    x:Name="ThisControl"
                    Title="{DynamicResource Text.FindContainingBranches.Title}"
                    Icon="/App.ico"
                    Width="680" Height="460" MinWidth="400" MinHeight="320"
                    CanResize="True" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}" PointerPressed="BeginMoveWindow"/>
      <Path Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left"
            Data="{StaticResource Icons.Search}" IsVisible="{OnPlatform True, macOS=False}"/>
      <TextBlock Classes="bold" Text="{DynamicResource Text.FindContainingBranches.Title}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <v:CaptionButtons HorizontalAlignment="Right" IsCloseButtonOnly="True" IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>
    <Grid Grid.Row="1" Margin="12" RowDefinitions="Auto,Auto,Auto,Auto">
      <TextBlock Text="{Binding RepositoryPath}" Foreground="{DynamicResource Brush.FG2}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RepositoryPath}"/>
      <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding SHA}" FontFamily="{DynamicResource Fonts.Monospace}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <v:CopyButton Grid.Column="1" Width="24" CopyText="{Binding SHA}" ToolTip.Tip="{DynamicResource Text.Copy}"/>
      </Grid>
      <TextBlock Grid.Row="2" Text="{Binding Subject}" Classes="bold" Margin="0,4,0,10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subject}"/>
      <TextBox Grid.Row="3" Text="{Binding SearchText, Mode=TwoWay}" Watermark="{DynamicResource Text.FindContainingBranches.Search}"/>
    </Grid>
    <Grid Grid.Row="2" Margin="12,0" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
        <v:LoadingIcon Width="16" Height="16" Margin="0,0,8,0" IsVisible="{Binding IsSearching}"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="72" ToolTip.Tip="{Binding Status}"/>
      </Grid>
      <ListBox x:Name="ResultsList" Grid.Row="1" ItemsSource="{Binding VisibleResults}" SelectionMode="Single">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ContainingBranch">
            <Grid ColumnDefinitions="4,24,*,Auto" MinHeight="32" Background="Transparent" ContextRequested="OnBranchContextRequested" ToolTip.Tip="{Binding Name}">
              <Border Background="{Binding Color}" Margin="0,5"/>
              <Path Grid.Column="1" Width="14" Height="14" Fill="{Binding Color}" Data="{StaticResource Icons.Branch}" IsVisible="{Binding IsLocal}"/>
              <Path Grid.Column="1" Width="14" Height="14" Fill="{Binding Color}" Data="{StaticResource Icons.Remote}" IsVisible="{Binding !IsLocal}"/>
              <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="3" Text="{Binding Kind}" Foreground="{DynamicResource Brush.FG2}" Margin="12,0,4,0" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Text="{DynamicResource Text.FindContainingBranches.NoMatches}"
                 IsVisible="{Binding IsEmpty}" Foreground="{DynamicResource Brush.FG2}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource Brush.TitleBar}" Padding="8" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Click="OnSearch" IsEnabled="{Binding !IsSearching}">
          <StackPanel Orientation="Horizontal" Spacing="6"><Path Width="12" Height="12" Data="{StaticResource Icons.Refresh}"/><TextBlock Text="{DynamicResource Text.FindContainingBranches.Retry}"/></StackPanel>
        </Button>
        <Button Click="OnCancel" IsVisible="{Binding IsSearching}" Content="{DynamicResource Text.Cancel}"/>
        <Button Click="OnClose" Content="{DynamicResource Text.Close}" MinWidth="90"/>
      </StackPanel>
    </Border>
  </Grid>
</v:ChromelessWindow>
