<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:m="using:SourceGit.Models"
                    xmlns:c="using:SourceGit.Converters"
                    mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="640"
                    x:Class="SourceGit.Views.RecursiveLocalChanges"
                    x:DataType="vm:RecursiveLocalChanges"
                    x:Name="ThisControl"
                    Title="{Binding Title}"
                    Icon="/App.ico"
                    Width="920"
                    Height="640"
                    MinWidth="720"
                    MinHeight="420"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Submodules}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{Binding Title}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <Border Grid.Row="1"
            Margin="8,12,8,0"
            Padding="12,10"
            Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border2}"
            BorderThickness="1"
            CornerRadius="6">
      <Grid RowDefinitions="Auto,Auto,Auto"
            ColumnDefinitions="*,Auto"
            RowSpacing="8">
        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Spacing="2">
          <TextBlock Classes="bold"
                     Text="Parent repository + changed submodules recursively"/>
          <TextBlock Text="{Binding SummaryText}"
                     Foreground="{DynamicResource Brush.FG2}"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox Grid.Row="1"
                 Grid.Column="0"
                 Watermark="Hide extensions like .pdb, .dll, .obj"
                 Text="{Binding HiddenExtensionFilterText, Mode=TwoWay}"
                 KeyDown="OnHiddenExtensionFilterKeyDown"
                 LostFocus="OnHiddenExtensionFilterLostFocus"/>

        <Button Grid.Row="1"
                Grid.Column="1"
                Classes="icon_button"
                Width="28"
                Height="28"
                Margin="12,0,0,0"
                Click="OnRefresh"
                ToolTip.Tip="Refresh">
          <Path Width="12" Height="12" Data="{StaticResource Icons.Refresh}"/>
        </Button>

        <StackPanel Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Orientation="Vertical"
                    Spacing="4"
                    IsVisible="{Binding HasRecentHiddenExtensions}">
          <TextBlock Text="Recent hidden types"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.FG2}"/>
          <ItemsControl ItemsSource="{Binding RecentHiddenExtensions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="flat"
                        Margin="0,0,6,4"
                        Padding="8,2"
                        Click="OnAppendRecentHiddenExtension">
                  <TextBlock Text="{Binding .}"
                             FontSize="11"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="8">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding HasRepositories}">
        <ItemsControl ItemsSource="{Binding Repositories}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:RecursiveLocalChanges+RepositoryEntry">
              <Border Margin="0,0,0,8"
                      Padding="12"
                      Background="{DynamicResource Brush.Contents}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1"
                      CornerRadius="6">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Path Grid.Column="0"
                          Width="14"
                          Height="14"
                          Margin="0,2,8,0"
                          VerticalAlignment="Top"
                          Fill="{DynamicResource Brush.FG2}"
                          Data="{StaticResource Icons.Changes}"
                          IsVisible="{Binding IsRoot}"/>
                    <Path Grid.Column="0"
                          Width="14"
                          Height="14"
                          Margin="0,2,8,0"
                          VerticalAlignment="Top"
                          Fill="{DynamicResource Brush.FG2}"
                          Data="{StaticResource Icons.Submodules}"
                          IsVisible="{Binding !IsRoot}"/>

                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Classes="bold"
                                 Text="{Binding DisplayName}"/>
                      <TextBlock Text="{Binding Description}"
                                 Foreground="{DynamicResource Brush.FG2}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="flat"
                            MinWidth="48"
                            Height="22"
                            Margin="8,0,0,0"
                            Padding="8,0"
                            VerticalAlignment="Center"
                            Click="OnToggleRepositoryEntryExpanded"
                            IsVisible="{Binding CanToggleExpanded}">
                      <TextBlock Text="{Binding ExpandToggleText}"
                                 FontSize="10"
                                 FontWeight="SemiBold"/>
                    </Button>

                    <Border Grid.Column="3"
                            Height="20"
                            Margin="8,0,0,0"
                            Padding="8,0"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Badge}">
                      <TextBlock Text="{Binding ChangeCountText}"
                                 Foreground="{DynamicResource Brush.BadgeFG}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </Grid>

                  <ItemsControl Grid.Row="1"
                                Margin="0,10,0,0"
                                ItemsSource="{Binding Changes}"
                                IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="m:Change">
                        <Grid RowDefinitions="Auto,Auto">
                          <Grid Grid.Row="0"
                                ColumnDefinitions="Auto,*,Auto"
                                Margin="0,0,0,2"
                                Cursor="Hand"
                                PointerPressed="OnOpenChangeDiff">
                            <v:ChangeStatusIcon Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Change="{Binding}"
                                                IsUnstagedChange="True"/>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding Path}"
                                       FontWeight="{Binding IsSubmodulePointerChange, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"/>

                            <TextBlock Grid.Column="2"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource Fonts.Monospace}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       IsVisible="{Binding HasLineStats}">
                              <Run Text="-"/>
                              <Run Text="{Binding DeletedLines}" Foreground="Tomato"/>
                              <Run Text="  +"/>
                              <Run Text="{Binding AddedLines}" Foreground="LimeGreen"/>
                            </TextBlock>
                          </Grid>

                          <TextBlock Grid.Row="1"
                                     Margin="24,0,0,4"
                                     Foreground="{DynamicResource Brush.FG2}"
                                     FontSize="11"
                                     Text="{Binding WorkTreeSubmodulePointerText}"
                                     IsVisible="{Binding WorkTreeSubmodulePointerText, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8"
                  IsVisible="{Binding ShowEmptyState}">
        <Path Width="48"
              Height="48"
              Data="{StaticResource Icons.Empty}"
              Fill="{DynamicResource Brush.FG2}"/>
        <TextBlock Text="No recursive local changes"
                   Foreground="{DynamicResource Brush.FG2}"/>
      </StackPanel>

      <v:LoadingIcon Width="48"
                     Height="48"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsLoading}"/>
    </Grid>
  </Grid>
</v:ChromelessWindow>
