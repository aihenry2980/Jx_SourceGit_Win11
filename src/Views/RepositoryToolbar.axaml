<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:c="using:SourceGit.Converters"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <Style Selector="TextBlock.toolbar_label">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="MaxWidth" Value="56"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.tooltip_cmd">
      <Setter Property="Foreground" Value="#FF0F8CFF"/>
      <Setter Property="FontFamily" Value="{DynamicResource Fonts.Monospace}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
      <Setter Property="MaxWidth" Value="1400"/>
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="1500"/>
    </Style>
    <Style Selector="Border.toolbar_status_chip">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,Auto,*">
    <StackPanel x:Name="LeftToolbarGroup" Grid.Column="0" Orientation="Horizontal" Margin="4,0,0,0">
      <Button x:Name="OpenWithExternalToolsButton" Classes="icon_button" Width="44" Click="OpenWithExternalTools">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Open this repository in external tools (Explorer, terminal, editor, browser remotes)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Open in VS Code and then open the origin URL in browser for PR review." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+O (menu), F6 (open folder)." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.OpenWith}"/>
          <TextBlock Classes="toolbar_label" Text="Open"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenWithExternalToolsByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+O, macOS=⌘+⌥+O}"/>

      <Button x:Name="LogsButton" Classes="icon_button" Width="44" Click="OpenGitLogs" ContextRequested="OnLogsContextRequested" PointerPressed="OnLogsPointerPressed">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="View SourceGit command logs and operation history for this repository." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Inspect recent fetch/pull/rebase commands and copy error output for troubleshooting." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+L." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" Margin="0,1,0,0" HorizontalAlignment="Center" Data="{StaticResource Icons.Logs}"/>
          <TextBlock Classes="toolbar_label" Text="Logs"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenGitLogs" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+L, macOS=⌘+⌥+L}"/>

      <Button Width="0" Height="0" Click="OpenMemoryProfilerByHotKey" IsVisible="False" HotKey="Ctrl+Alt+M"/>
      <Button Width="0" Height="0" Click="OpenCpuProfilerByHotKey" IsVisible="False" HotKey="Ctrl+Alt+Shift+M"/>
      <Button Classes="icon_button" Width="44" Click="OpenStatistics">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Show repository statistics such as commit activity and contributor trends." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Compare activity between branches or identify busiest commit periods." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+I." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="13" Height="13" HorizontalAlignment="Center" Data="{StaticResource Icons.Statistics}"/>
          <TextBlock Classes="toolbar_label" Text="Stats"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenStatistics" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+I, macOS=⌘+⌥+I}"/>

      <Button Classes="icon_button" Width="44" Click="OpenConfigure">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Open repository configuration (Git settings, local ignore, commit template, issue tracker, custom actions)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Add repo-only ignore rules in .git/info/exclude without touching tracked .gitignore." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+C." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Settings}"/>
          <TextBlock Classes="toolbar_label" Text="Config"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenConfigure" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+C, macOS=⌘+⌥+C}"/>
    </StackPanel>

    <StackPanel x:Name="CenterToolbarGroup" Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="SuperQuickFetchButton"
              Classes="icon_button"
              Width="56"
              Click="SuperQuickFetch"
              Tag="SuperQuickFetch"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Super quick fetch only the explicitly included branch filters on the preferred remote." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Use this when you only care about the currently filtered branch targets and want the fastest possible refresh." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git fetch --progress --verbose --no-tags &lt;preferred-remote&gt; &lt;filtered-refspecs...&gt;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+Shift+F." Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="If no included branch filters match the preferred remote, it skips the fetch and tells you why." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FF5B3CC4" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" HorizontalAlignment="Center" Fill="#FFFFE066" Data="{StaticResource Icons.Lightning}"/>
          </Border>
          <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="SQFetch"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="SuperQuickFetchByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+Shift+F, macOS=âŒ˜+âŒ¥+â‡§+F}"/>

      <Button x:Name="QuickFetchButton"
              Classes="icon_button"
              Width="56"
              Margin="8,0,0,0"
              Tapped="QuickFetch"
              Tag="QuickFetch"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Quick fetch the preferred remote only, without tags, prune, or recursive submodule work." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Use this when you only want to know whether new commits arrived as fast as possible." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git fetch --progress --verbose --no-tags &lt;preferred-remote&gt;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+F." Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="It runs directly in background, writes to repository logs, and uses the fast recent-history refresh path." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FFEAA400" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" HorizontalAlignment="Center" Fill="White" Data="{StaticResource Icons.Lightning}"/>
          </Border>
          <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="QFetch"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="QuickFetchByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+F, macOS=⌘+⌥+F}"/>

      <Button x:Name="FetchButton"
              Classes="icon_button"
              Width="56"
              Margin="8,0,0,0"
              Tapped="Fetch"
              Tag="Fetch"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Fetch remote updates (new commits/refs) without modifying your working tree or current branch." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Fetch first, inspect incoming commits in graph, then decide whether to pull or rebase." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git fetch --progress --verbose --no-tags [&lt;selected-remote&gt; or all-remotes]"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Down (direct fetch)." Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Fetch}"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>

      <Button x:Name="QuickPullButton"
              Classes="icon_button"
              Width="56"
              Margin="8,0,0,0"
              Tapped="QuickPull"
              Tag="QuickPull"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed"
              IsVisible="{Binding !IsBare}"
              IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Quick pull the tracked upstream using an explicit fetch plus fast-forward-only merge." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Use this for the common case where the branch can move forward cleanly and you want a faster update path than the full pull popup flow." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git fetch --progress --verbose &lt;remote&gt; refs/heads/&lt;branch&gt;:refs/remotes/&lt;remote&gt;/&lt;branch&gt;"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,2,0,0" Text="git merge --progress --no-edit --ff-only &lt;remote&gt;/&lt;branch&gt;"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="It runs directly in background, writes to repository logs, and fails instead of silently falling back if a fast-forward is not possible." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FF0F766E" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" HorizontalAlignment="Center" Fill="#FFFFE066" Data="{StaticResource Icons.Pull}"/>
          </Border>
          <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="QPull"/>
        </StackPanel>
      </Button>

      <Button x:Name="PullButton"
              Classes="icon_button"
              Width="56"
              Margin="8,0,0,0"
              Tapped="Pull"
              Tag="Pull"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed"
              IsVisible="{Binding !IsBare}"
              IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Pull remote changes into the current local branch using merge mode." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Pull origin/main to keep your local main aligned before starting new work." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git pull --verbose --progress --no-rebase &lt;remote&gt; &lt;branch&gt;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Shift+Down (direct pull)." Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FF1D6FDD" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" HorizontalAlignment="Center" Fill="White" Data="{StaticResource Icons.Pull}"/>
          </Border>
          <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="{DynamicResource Text.Pull}"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>

      <Button x:Name="SyncAllButton" Classes="icon_button" Width="56" Margin="8,0,0,0" Tapped="SyncAll" Tag="SyncAll" ContextRequested="OnSyncAllContextRequested" PointerPressed="OnSyncAllPointerPressed" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Click: pull current branch, then update selected submodules recursively." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Ctrl+click: also run fetch+prune recursively for the parent repository and submodules after the update finishes." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="Click: git pull --verbose --progress ..."/>
            <TextBlock Classes="tooltip_cmd" Margin="0,2,0,0" Text="then: git submodule update --recursive --init -- &lt;selected-submodules...&gt;"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,2,0,0">
              <Run Text="Ctrl+click adds: git fetch --progress --verbose --no-tags "/>
              <Run Text="--prune " Foreground="#FFE74C3C"/>
              <Run Text="--recurse-submodules &lt;remote&gt;"/>
            </TextBlock>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="A progress window shows live syntax-highlighted git output and stops immediately on the first error." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FF0E7490" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" Fill="#FFFFE066" Data="{StaticResource Icons.Action}"/>
          </Border>
          <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="Sync All"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Width="56" Margin="8,0,0,0" Tapped="Push" IsVisible="False">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Push local commits to remote so teammates and CI can see your latest branch state." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Push feature branch after tests pass, then open or update a pull request." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Shift+Up (direct push)." Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Push}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Push}"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>

      <Button x:Name="FetchRecursivelyButton"
              Classes="icon_button"
              Width="56"
              Margin="8,0,0,0"
              Tapped="FetchRecursivelyWithOptionalPrune"
              Tag="FetchRecursively"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Click: fetch recursively and prune stale remote refs for the root repository and configured submodules." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Ctrl+click: fetch recursively without pruning." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0">
              <Run Text="Click: git fetch --progress --verbose --no-tags "/>
              <Run Text="--prune " Foreground="#FFE74C3C"/>
              <Run Text="--recurse-submodules &lt;remote&gt;"/>
            </TextBlock>
            <TextBlock Classes="tooltip_cmd" Margin="0,2,0,0">
              <Run Text="Ctrl+click: git fetch --progress --verbose --no-tags --recurse-submodules &lt;remote&gt;"/>
            </TextBlock>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Use click after remote branch cleanup, or Ctrl+click when you only want fresh refs without deleting stale ones yet." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="If Sync All submodule targets were configured, this button uses the same saved submodule selection." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcuts: Ctrl+Alt+Shift+Down = prune, Ctrl+Alt+Down = no prune." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FFD13438" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" Margin="0,1,0,0" Fill="White" Data="{StaticResource Icons.Clean}"/>
          </Border>
          <TextBlock Classes="toolbar_label" Text="F+Prune"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="FetchAndPruneRecursively" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+Shift+Down, macOS=⌘+⌥+⇧+Down}"/>

      <Button x:Name="RefreshButton"
              Classes="icon_button"
              Width="56"
              Margin="8,0,0,0"
              Click="RefreshHistoryGraph"
              Tag="Refresh"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Refresh history panel immediately (branches + commits) and rebuild graph layout." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Use after external git commands or local ignore updates to force a clean visual refresh." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="Queries: git branch ... | git log ... | git submodule status"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: F5 (refresh active repository)." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FF5C2D91" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" Fill="White" Data="{StaticResource Icons.Refresh}"/>
          </Border>
          <TextBlock Classes="toolbar_label" Text="Refresh"/>
        </StackPanel>
      </Button>

      <Button Width="0" Height="0" Click="FetchRecursively" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+Down, macOS=⌘+⌥+Down}"/>

      <Button x:Name="UndoRecentCommandsButton" Classes="icon_button" Width="56" Margin="8,0,0,0" Click="UndoRecentCommands" Tag="UndoRecentCommands" ContextRequested="OnToolbarGitButtonContextRequested" PointerPressed="OnToolbarGitButtonPointerPressed" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Show the latest reversible HEAD-changing git commands and choose whether to undo the recent 1, 2, or 3 commands." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: If pull, merge, or rebase moved the branch somewhere unexpected, pick how many recent commands to roll back." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git reflog -n 4 HEAD"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,2,0,0" Text="then: git reset --{soft|mixed|hard} &lt;target-sha&gt;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+Z." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FFCA5010" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" Fill="White" Data="{StaticResource Icons.Undo}"/>
          </Border>
          <TextBlock Classes="toolbar_label" Text="Undo R"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="UndoLastRebase" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Alt+Z, macOS=⌘+⌥+Z}"/>

      <Button x:Name="UpdateSubmodulesRecursivelyButton"
              Classes="icon_button"
              Width="56"
              Margin="8,0,0,0"
              Click="UpdateSubmodulesRecursively"
              Tag="UpdateSubmodulesRecursively"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed"
              IsVisible="{Binding !IsBare}"
              IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Update submodules recursively to the revisions recorded by the parent repository." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: After pulling parent changes, run this to sync all submodules to expected commits." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git submodule update --recursive --init -- &lt;selected-submodules...&gt;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+U." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FF10893E" CornerRadius="5" Padding="4">
            <Path Width="14" Height="14" Fill="White" Data="{StaticResource Icons.Submodule}"/>
          </Border>
          <TextBlock Classes="toolbar_label" Text="Submod R"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="UpdateSubmodulesRecursively" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Alt+U, macOS=⌘+⌥+U}"/>

      <Button x:Name="StashAllButton"
              Classes="icon_button"
              Width="56"
              Margin="8,0,0,0"
              Tapped="StashAll"
              Tag="StashAll"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed"
              IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Stash all current working-tree and index changes into a temporary WIP snapshot." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Save unfinished edits before branch checkout, then re-apply later from stash list." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git stash push --include-untracked -m &quot;WIP&quot;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+S." Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Stashes.Add}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Stash}"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="StashAllByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Alt+S, macOS=⌘+⌥+S}"/>

      <Rectangle x:Name="ActionSeparator"
                 Width="1" Height="16"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource Brush.Border2}"/>

      <Button Classes="icon_button" Width="56" Margin="8,0,0,0" Command="{Binding CreateNewBranch}" IsVisible="False">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Create a new local branch from the currently selected commit or current HEAD." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Branch from a historical fix commit to prepare a quick hotfix release." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Shift+B (Create Branch dialog)." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Classes="toolbar_label" Text="Branch"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="CreateNewBranchByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+B, macOS=⌘+⇧+B}"/>
      <Button x:Name="OpenCustomActionMenuButton" Classes="icon_button" Width="56" Margin="8,0,0,0" Click="OpenCustomActionMenu">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Run user-defined custom actions (project scripts/commands) configured for this repository." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Trigger one-click build, test, or deploy helper commands from menu." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+A." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Action}"/>
          <TextBlock Classes="toolbar_label" Text="Actions"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Width="56" Margin="8,0,0,0" Click="Cleanup" IsVisible="False">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Clean untracked files and directories from working tree (dangerous if misused)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Remove generated build artifacts and temporary outputs before packaging." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+X." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" Margin="0,1,0,0" HorizontalAlignment="Center" Data="{StaticResource Icons.Clean}"/>
          <TextBlock Classes="toolbar_label" Text="Clean"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenCustomActionMenuByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+A, macOS=⌘+⌥+A}"/>
      <Button Width="0" Height="0" Click="Cleanup" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+X, macOS=⌘+⌥+X}"/>
    </StackPanel>

    <StackPanel x:Name="RightToolbarGroup" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
      <Button Classes="icon_button"
              Width="28"
              Height="24"
              Margin="6,0,0,0"
              ToolTip.Placement="Bottom">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="520">
            <TextBlock FontWeight="Bold" Text="History marker legend"/>
            <TextBlock Classes="small" Margin="0,6,0,0" Text="SPP and PARENT are special ref chips in commit refs."/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="8">
              <Border Padding="8,2" CornerRadius="10" Background="#FF1D6FDD" BorderBrush="#FF114B99" BorderThickness="1">
                <TextBlock Foreground="#FFFFE066" FontWeight="Bold" Text="SPP"/>
              </Border>
              <Border Padding="8,2" CornerRadius="10" Background="#FF0F5A2E" BorderBrush="#FF0A4020" BorderThickness="1">
                <TextBlock Foreground="#FFFFE066" FontWeight="Bold" Text="PARENT"/>
              </Border>
            </StackPanel>
            <TextBlock Margin="0,8,0,0">
              <Run Text="Purple bold SHA"/>
              <Run Text=" means the commit contains an SPP/submodule-pointer change."/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="8">
              <TextBlock Foreground="#FF7C3AED" FontWeight="Bold" Text="95977"/>
              <Border Width="16" Height="16" CornerRadius="8" Background="#FF7C3AED" BorderBrush="#FF5B21B6" BorderThickness="1">
                <Path Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource Icons.Submodule}" Fill="#FFF7D047"/>
              </Border>
            </StackPanel>
            <TextBlock Classes="small" Margin="0,8,0,0" Text="Grey ref chips appear because the commit is part of the filtered history, not because that ref itself matched your included filter." TextWrapping="Wrap"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="12" Height="12" Data="{StaticResource Icons.Info}"/>
      </Button>

      <Path Width="13" Height="13" Fill="{DynamicResource Brush.FG1}" Data="{StaticResource Icons.Branch}"/>

      <Border Margin="6,0,0,0"
              Padding="6,2"
              CornerRadius="4"
              Background="{Binding CurrentBranchDisplayBackground}"
              BorderBrush="{DynamicResource Brush.Border1}"
              BorderThickness="1"
              Cursor="Hand"
              ToolTip.Tip="{Binding CurrentBranchDisplayName}"
              PointerPressed="OnCurrentBranchNamePointerPressed">
        <TextBlock Text="{Binding CurrentBranchDisplayLabel}"
                   MaxWidth="250"
                   MaxLines="2"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{Binding CurrentBranchDisplayForeground}"/>
      </Border>

      <Button Classes="icon_button" Width="56" Click="NavigateToHead">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Jump graph and selection to the current HEAD commit (active branch tip or detached HEAD)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Instantly return to your working position after exploring old commit history." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+H." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="13" Height="13" Margin="0,2,0,0" HorizontalAlignment="Center" Data="{StaticResource Icons.Target}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Classes="toolbar_label" Text="Head"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="NavigateToHead" IsVisible="False" HotKey="{OnPlatform Ctrl+H, macOS=⌘+⌥+H}"/>      <Button Classes="icon_button"
              Width="56"
              Margin="4,0,0,0"
              Click="NavigateToSuperProjectPointer"
              IsVisible="{Binding HasSuperProjectPointer}"
              IsEnabled="{Binding HasSuperProjectPointer}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Jump graph and selection to the SPP commit (super-project pointer for this submodule)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Quickly locate the exact submodule commit currently pinned by the parent repository." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="13" Height="13" Margin="0,2,0,0" HorizontalAlignment="Center" Data="{StaticResource Icons.Submodule}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Classes="toolbar_label" Text="SPP"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
