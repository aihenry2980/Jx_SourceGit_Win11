<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:c="using:SourceGit.Converters"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Toolbar.Fetch" Color="#2563EB"/>
          <SolidColorBrush x:Key="Toolbar.Pull" Color="#0F766E"/>
          <SolidColorBrush x:Key="Toolbar.Undo" Color="#B45309"/>
          <SolidColorBrush x:Key="Toolbar.Submodules" Color="#10893E"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Toolbar.Fetch" Color="#80ADFF"/>
          <SolidColorBrush x:Key="Toolbar.Pull" Color="#62D6CA"/>
          <SolidColorBrush x:Key="Toolbar.Undo" Color="#FBBF60"/>
          <SolidColorBrush x:Key="Toolbar.Submodules" Color="#72D99A"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.toolbar_label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="MaxWidth" Value="78"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Button.toolbar_button">
      <Setter Property="Height" Value="46"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.toolbar_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
    </Style>
    <Style Selector="Border.toolbar_group">
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBlock.tooltip_cmd">
      <Setter Property="Foreground" Value="#FF0F8CFF"/>
      <Setter Property="FontFamily" Value="{DynamicResource Fonts.Monospace}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
      <Setter Property="MaxWidth" Value="1400"/>
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="1500"/>
    </Style>
    <Style Selector="Border.toolbar_status_chip">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*,Auto">
    <StackPanel x:Name="LeftToolbarGroup" Grid.Column="0" Orientation="Horizontal" Margin="4,2,6,2">
      <Button x:Name="OpenWithExternalToolsButton" Classes="icon_button toolbar_button" Width="44" Click="OpenWithExternalTools">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Open this repository in external tools (Explorer, terminal, editor, browser remotes)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Open in VS Code and then open the origin URL in browser for PR review." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+O (menu), F6 (open folder)." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.OpenWith}"/>
          <TextBlock Classes="toolbar_label" Text="Open"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenWithExternalToolsByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+O, macOS=⌘+⌥+O}"/>

      <Button x:Name="LogsButton" Classes="icon_button toolbar_button" Width="44" Click="OpenGitLogs" ContextRequested="OnLogsContextRequested" PointerPressed="OnLogsPointerPressed">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="View SourceGit command logs and operation history for this repository." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Inspect recent fetch/pull/rebase commands and copy error output for troubleshooting." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+L." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" Margin="0,1,0,0" HorizontalAlignment="Center" Data="{StaticResource Icons.Logs}"/>
          <TextBlock Classes="toolbar_label" Text="Logs"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenGitLogs" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+L, macOS=⌘+⌥+L}"/>

      <Button Width="0" Height="0" Click="OpenMemoryProfilerByHotKey" IsVisible="False" HotKey="Ctrl+Alt+M"/>
      <Button Width="0" Height="0" Click="OpenCpuProfilerByHotKey" IsVisible="False" HotKey="Ctrl+Alt+Shift+M"/>
      <Button Classes="icon_button toolbar_button" Width="44" Click="OpenStatistics">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Show repository statistics such as commit activity and contributor trends." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Compare activity between branches or identify busiest commit periods." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+I." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="13" Height="13" HorizontalAlignment="Center" Data="{StaticResource Icons.Statistics}"/>
          <TextBlock Classes="toolbar_label" Text="Stats"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenStatistics" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+I, macOS=⌘+⌥+I}"/>

      <Button Classes="icon_button toolbar_button" Width="60" Click="CompareWithOtherRepo">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Compare this repo with another open repo on the same remote URL but a different checked-out branch." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Shows changed files plus submodule SHA differences between the two current branch tips." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Compare}"/>
          <TextBlock Classes="toolbar_label" Text="Compare"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button toolbar_button" Width="52" Click="OpenConfigure">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Open repository configuration (Git settings, local ignore, commit template, issue tracker, custom actions)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Add repo-only ignore rules in .git/info/exclude without touching tracked .gitignore." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+C." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Settings}"/>
          <TextBlock Classes="toolbar_label" Text="Config"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenConfigure" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+C, macOS=⌘+⌥+C}"/>
      <Path Width="13" Height="13" Margin="10,0,0,0" Fill="{DynamicResource Brush.FG1}" Data="{StaticResource Icons.Branch}"/>

      <Border Margin="6,0,0,0"
              Padding="6,2"
              CornerRadius="4"
              Background="{Binding CurrentBranchDisplayBackground}"
              BorderBrush="{DynamicResource Brush.Border1}"
              BorderThickness="1"
              Cursor="Hand"
              ToolTip.Tip="{Binding CurrentBranchDisplayName}"
              PointerPressed="OnCurrentBranchNamePointerPressed">
        <TextBlock Text="{Binding CurrentBranchDisplayLabel}"
                   MaxWidth="180"
                   MaxLines="2"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{Binding CurrentBranchDisplayForeground}"/>
      </Border>

      <Border Margin="6,0,0,0"
              Height="18"
              Padding="6,0"
              CornerRadius="9"
              Background="{DynamicResource Brush.Badge}"
              VerticalAlignment="Center"
              IsVisible="{Binding CurrentBranch?.IsTrackStatusVisible, TargetNullValue=False, Mode=OneWay}">
        <TextBlock Text="{Binding CurrentBranch?.TrackStatusDescription, Mode=OneWay}"
                   FontFamily="{DynamicResource Fonts.Monospace}"
                   FontSize="11"
                   Foreground="{DynamicResource Brush.BadgeFG}"/>
      </Border>
    </StackPanel>

    <WrapPanel x:Name="CenterToolbarGroup"
               Grid.Column="1"
               Orientation="Horizontal"
               HorizontalAlignment="Center">
    <StackPanel Orientation="Horizontal" Margin="4,2">
      <Button x:Name="SubmoduleCommitFlowButton"
              Classes="icon_button toolbar_button"
              Width="60"
              Click="OpenSubmoduleCommitFlow">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Open the recursive submodule commit flow." TextWrapping="Wrap" MaxWidth="520"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Use this to commit the deepest dirty submodule first, then peg submodule pointer updates upward without switching tabs." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="520"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Border Background="#FF0F766E" CornerRadius="4" Padding="3" Width="24" Height="24" HorizontalAlignment="Center">
            <Path Width="18" Height="18" HorizontalAlignment="Center" Fill="#FFFFE066" Data="{StaticResource Icons.Commit}"/>
          </Border>
          <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="Commit"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenSubmoduleCommitFlow" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+Shift+F, macOS=âŒ˜+âŒ¥+â‡§+F}"/>

    </StackPanel>

    <Border Classes="toolbar_group" BorderBrush="{DynamicResource Toolbar.Fetch}" Background="#0C2563EB">
      <StackPanel x:Name="FetchToolbarGroup" Orientation="Horizontal">
        <!-- Standard SourceGit Fetch entry point -->
        <Button x:Name="FetchButton"
                Classes="icon_button toolbar_button"
                AutomationProperties.Name="Fetch"
                Width="56"
                Margin="0"
                Tapped="Fetch">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock Text="{DynamicResource Text.Fetch}"/>
              <TextBlock Classes="small" Margin="0,4,0,0" Text="Open the standard SourceGit fetch options." Foreground="{DynamicResource Brush.FG2}"/>
              <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Ctrl+click runs directly. Shortcut: Ctrl+Down." Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </ToolTip.Tip>

          <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
            <Grid Width="24" Height="24">
              <Path Width="18" Height="18" HorizontalAlignment="Center" Fill="{DynamicResource Toolbar.Fetch}" Data="{StaticResource Icons.Fetch}"/>
            </Grid>
            <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="Fetch"/>
          </StackPanel>
        </Button>
        <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>

        <!-- Fetch scope: all branches on the selected remote(s) -->
        <Button x:Name="FetchAllBranchesButton"
                Classes="icon_button toolbar_button"
                AutomationProperties.Name="Fetch all branches"
                Width="56"
                Margin="0"
                Tapped="FetchAllBranches"
                Tag="FetchAllBranches"
                ContextRequested="OnToolbarGitButtonContextRequested"
                PointerPressed="OnToolbarGitButtonPointerPressed">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock Text="Fetch all branch refs from the preferred remote." TextWrapping="Wrap" MaxWidth="680"/>
              <TextBlock Classes="small" Margin="0,4,0,0" Text="Runs immediately against the preferred remote without tags or submodule recursion." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="680"/>
              <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git fetch --progress --verbose &lt;remote&gt;"/>
              <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Alt+click: hand off to TortoiseGit Fetch." Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
            <Grid Width="24" Height="24">
              <Path Width="18" Height="18" Fill="{DynamicResource Toolbar.Fetch}" Data="{StaticResource Icons.Branch}"/>
            </Grid>
            <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="All"/>
          </StackPanel>
        </Button>
        <!-- Fetch scope: root repository and configured submodules -->
        <Button x:Name="FetchWithSubmodulesButton"
                Classes="icon_button toolbar_button"
                AutomationProperties.Name="Fetch repository and submodules"
                Width="56"
                Margin="0"
                Tapped="FetchRecursivelyWithOptionalPrune"
                Tag="FetchRecursively"
                ContextRequested="OnToolbarGitButtonContextRequested"
                PointerPressed="OnToolbarGitButtonPointerPressed">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock Text="Fetch the root repository and configured submodules recursively." TextWrapping="Wrap" MaxWidth="680"/>
              <TextBlock Classes="small" Margin="0,4,0,0" Text="Click also prunes stale remote refs. Ctrl+click fetches without pruning. The saved submodule selection is reused." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="680"/>
              <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git fetch --prune; git -C &lt;submodule&gt; fetch --recurse-submodules --prune"/>
              <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcuts: Ctrl+Alt+Shift+Down = prune; Ctrl+Alt+Down = no prune." Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </ToolTip.Tip>

          <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
            <Grid Width="24" Height="24">
              <Path Width="18" Height="18" Fill="{DynamicResource Toolbar.Fetch}" Data="{StaticResource Icons.Submodule}"/>
            </Grid>
            <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="Subs"/>
          </StackPanel>
        </Button>
        <Button Width="0" Height="0" Click="FetchAndPruneRecursively" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+Shift+Down, macOS=⌘+⌥+⇧+Down}"/>
        <Button Width="0" Height="0" Click="FetchRecursively" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+Down, macOS=⌘+⌥+Down}"/>

      </StackPanel>
    </Border>

    <Border Classes="toolbar_group" BorderBrush="{DynamicResource Toolbar.Pull}" Background="#0C0F766E" IsVisible="{Binding !IsBare}">
      <StackPanel x:Name="PullToolbarGroup" Orientation="Horizontal">
        <!-- Standard SourceGit Pull entry point -->
        <Button x:Name="PullButton"
                Classes="icon_button toolbar_button"
                AutomationProperties.Name="Pull"
                Width="56"
                Margin="0"
                Tapped="Pull"
                IsVisible="{Binding !IsBare}"
                IsEnabled="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock Text="{DynamicResource Text.Pull}"/>
              <TextBlock Classes="small" Margin="0,4,0,0" Text="Open the standard SourceGit pull options." Foreground="{DynamicResource Brush.FG2}"/>
              <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Ctrl+click runs directly. Shortcut: Ctrl+Shift+Down." Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </ToolTip.Tip>

          <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
            <Grid Width="24" Height="24" HorizontalAlignment="Center">
              <Path Width="18" Height="18" Fill="{DynamicResource Toolbar.Pull}" Data="{StaticResource Icons.Pull}"/>
              <Ellipse Width="7" Height="7"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Fill="Green"
                       IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
            </Grid>
            <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="Pull"/>
          </StackPanel>
        </Button>

        <!-- Pull scope: top repository only -->
        <Button x:Name="PullTopRepositoryButton"
                Classes="icon_button toolbar_button"
                AutomationProperties.Name="Pull top repository only"
                Width="56"
                Margin="0"
                Tapped="Pull"
                Tag="Pull"
                ContextRequested="OnToolbarGitButtonContextRequested"
                PointerPressed="OnToolbarGitButtonPointerPressed"
                IsVisible="{Binding !IsBare}"
                IsEnabled="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock Text="Pull remote changes into the current branch of the top repository only." TextWrapping="Wrap" MaxWidth="680"/>
              <TextBlock Classes="small" Margin="0,4,0,0" Text="Submodule working trees are left untouched. Click opens pull options; Ctrl+click starts directly." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="680"/>
              <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git pull --verbose --progress --no-rebase &lt;remote&gt; &lt;branch&gt;"/>
              <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Shift+Down (direct pull)." Foreground="{DynamicResource Brush.FG2}"/>
              <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Alt+click: hand off to TortoiseGit Pull." Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </ToolTip.Tip>

          <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
            <Grid Width="24" Height="24">
              <Path Width="18" Height="18" Fill="{DynamicResource Toolbar.Pull}" Data="{StaticResource Icons.Home}"/>
            </Grid>
            <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="Top"/>
          </StackPanel>
        </Button>
        <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>

        <!-- Pull scope: top repository followed by recursive submodule update -->
        <Button x:Name="PullWithSubmodulesButton"
                Classes="icon_button toolbar_button"
                AutomationProperties.Name="Pull repository and update submodules"
                Width="56"
                Margin="0"
                Tapped="SyncAll"
                Tag="SyncAll"
                ContextRequested="OnSyncAllContextRequested"
                PointerPressed="OnSyncAllPointerPressed"
                IsVisible="{Binding !IsBare}"
                IsEnabled="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock Text="Pull the top repository, then update configured submodules recursively." TextWrapping="Wrap" MaxWidth="680"/>
              <TextBlock Classes="small" Margin="0,4,0,0" Text="The operation stops on the first failed stage and shows live Git output. Right-click to choose which submodules participate." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="680"/>
              <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git pull ...; git submodule update --recursive --init"/>
              <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Ctrl+click additionally fetches and prunes the configured submodules." Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </ToolTip.Tip>

          <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
            <Grid Width="24" Height="24">
              <Path Width="18" Height="18" Fill="{DynamicResource Toolbar.Pull}" Data="{StaticResource Icons.Submodule}"/>
            </Grid>
            <TextBlock Classes="toolbar_label" FontWeight="SemiBold" Text="Subs"/>
          </StackPanel>
        </Button>

      </StackPanel>
    </Border>

    <StackPanel x:Name="MaintenanceToolbarGroup" Orientation="Horizontal" Margin="6,2">
      <Button x:Name="RefreshButton"
              Classes="icon_button toolbar_button"
              Width="64"
              Margin="0"
              Click="RefreshHistoryGraph"
              Tag="Refresh"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Refresh history panel immediately (branches + commits) and rebuild graph layout." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Use after external git commands or local ignore updates to force a clean visual refresh." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="Queries: git branch ... | git log ... | git submodule status"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: F5 (refresh active repository)." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Grid Width="24" Height="24">
            <Path Width="18" Height="18" Fill="{DynamicResource Brush.FG1}" Data="{StaticResource Icons.Refresh}"/>
          </Grid>
          <TextBlock Classes="toolbar_label" Text="Refresh"/>
        </StackPanel>
      </Button>

      <Button x:Name="UndoRecentCommandsButton" Classes="icon_button toolbar_button" Width="56" Margin="0" Click="UndoRecentCommands" Tag="UndoRecentCommands" ContextRequested="OnToolbarGitButtonContextRequested" PointerPressed="OnToolbarGitButtonPointerPressed" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Show the latest reversible HEAD-changing git commands and choose whether to undo the recent 1, 2, or 3 commands." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: If pull, merge, or rebase moved the branch somewhere unexpected, pick how many recent commands to roll back." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git reflog -n 4 HEAD"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,2,0,0" Text="then: git reset --{soft|mixed|hard} &lt;target-sha&gt;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+Z." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Grid Width="24" Height="24">
            <Path Width="18" Height="18" Fill="{DynamicResource Toolbar.Undo}" Data="{StaticResource Icons.Undo}"/>
          </Grid>
          <TextBlock Classes="toolbar_label" Text="Undo"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="UndoLastRebase" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Alt+Z, macOS=⌘+⌥+Z}"/>

      <Button x:Name="UpdateSubmodulesRecursivelyButton"
              Classes="icon_button toolbar_button"
              Width="80"
              Margin="0"
              Tapped="UpdateSubmodulesRecursively"
              Tag="UpdateSubmodulesRecursively"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed"
              IsVisible="{Binding !IsBare}"
              IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Update submodules recursively to the revisions recorded by the parent repository." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: After pulling parent changes, run this to sync all submodules to expected commits." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git submodule update --recursive --init -- &lt;selected-submodules...&gt;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+U." Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Alt+click: hand off to TortoiseGit Submodule Update." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Grid Width="24" Height="24">
            <Path Width="18" Height="18" Fill="{DynamicResource Toolbar.Submodules}" Data="{StaticResource Icons.Submodule}"/>
          </Grid>
          <TextBlock Classes="toolbar_label" Text="Submodules"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="UpdateSubmodulesRecursively" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Alt+U, macOS=⌘+⌥+U}"/>

      <Button x:Name="StashAllButton"
              Classes="icon_button toolbar_button"
              Width="56"
              Margin="8,0,0,0"
              Tapped="StashAll"
              Tag="StashAll"
              ContextRequested="OnToolbarGitButtonContextRequested"
              PointerPressed="OnToolbarGitButtonPointerPressed"
              IsVisible="False">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Stash all current working-tree and index changes into a temporary WIP snapshot." TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Save unfinished edits before branch checkout, then re-apply later from stash list." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="960"/>
            <TextBlock Classes="tooltip_cmd" Margin="0,4,0,0" Text="git stash push --include-untracked -m &quot;WIP&quot;"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+S." Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Stashes.Add}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Stash}"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="StashAllByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Alt+S, macOS=⌘+⌥+S}"/>

      <Button Classes="icon_button toolbar_button" Width="32" Margin="16,0,0,0" Command="{Binding ApplyPatch}" IsVisible="False" ToolTip.Tip="{DynamicResource Text.Apply.Title}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.ApplyPatch}"/>
      </Button>

    </StackPanel>

    <StackPanel x:Name="CustomToolbarGroup" Orientation="Horizontal" Margin="6,2">
      <Rectangle x:Name="ActionSeparator"
                 Width="1" Height="28"
                 Margin="0,0,4,0"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource Brush.Border2}"/>

      <Button Classes="icon_button toolbar_button" Width="56" Margin="8,0,0,0" Command="{Binding CreateNewBranch}" IsVisible="False">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Create a new local branch from the currently selected commit or current HEAD." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Branch from a historical fix commit to prepare a quick hotfix release." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Shift+B (Create Branch dialog)." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Classes="toolbar_label" Text="Branch"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="CreateNewBranchByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+B, macOS=⌘+⇧+B}"/>
      <Button x:Name="OpenCustomActionMenuButton" Classes="icon_button toolbar_button" Width="56" Margin="8,0,0,0" Click="OpenCustomActionMenu">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Run user-defined custom actions (project scripts/commands) configured for this repository." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Trigger one-click build, test, or deploy helper commands from menu." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+A." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Action}"/>
          <TextBlock Classes="toolbar_label" Text="Actions"/>
        </StackPanel>
      </Button>

      <StackPanel x:Name="CustomActionSlots" Orientation="Horizontal">
        <Button x:Name="CustomActionSlot0Button" Classes="icon_button toolbar_button" Width="68" Margin="8,0,0,0" Click="ExecuteToolbarCustomAction" Tag="0"/>
        <Button x:Name="CustomActionSlot1Button" Classes="icon_button toolbar_button" Width="68" Margin="8,0,0,0" Click="ExecuteToolbarCustomAction" Tag="1"/>
        <Button x:Name="CustomActionSlot2Button" Classes="icon_button toolbar_button" Width="68" Margin="8,0,0,0" Click="ExecuteToolbarCustomAction" Tag="2"/>
      </StackPanel>

      <Button Classes="icon_button toolbar_button" Width="56" Margin="8,0,0,0" Click="Cleanup" IsVisible="False">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Clean untracked files and directories from working tree (dangerous if misused)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Remove generated build artifacts and temporary outputs before packaging." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+Alt+X." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" Margin="0,1,0,0" HorizontalAlignment="Center" Data="{StaticResource Icons.Clean}"/>
          <TextBlock Classes="toolbar_label" Text="Clean"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="OpenCustomActionMenuByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+A, macOS=⌘+⌥+A}"/>
      <Button Width="0" Height="0" Click="Cleanup" IsVisible="False" HotKey="{OnPlatform Ctrl+Alt+X, macOS=⌘+⌥+X}"/>
    </StackPanel>

    </WrapPanel>

    <StackPanel x:Name="RightToolbarGroup" Grid.Column="2" Orientation="Horizontal" Margin="6,2,4,2">
      <Button Classes="icon_button toolbar_button"
              Width="28"
              Height="24"
              Margin="6,0,0,0"
              ToolTip.Placement="Bottom">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical" MaxWidth="520">
            <TextBlock FontWeight="Bold" Text="History marker legend"/>
            <TextBlock Classes="small" Margin="0,6,0,0" Text="SPP marks the commit pinned by a super-project. PARENT is a repository status shown in the graph header."/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="8">
              <Border Padding="8,2" CornerRadius="10" Background="#FF1D6FDD" BorderBrush="#FF114B99" BorderThickness="1">
                <TextBlock Foreground="#FFFFE066" FontWeight="Bold" Text="SPP"/>
              </Border>
              <Border Padding="8,2" CornerRadius="10" Background="#FF0F5A2E" BorderBrush="#FF0A4020" BorderThickness="1">
                <TextBlock Foreground="#FFFFE066" FontWeight="Bold" Text="PARENT"/>
              </Border>
            </StackPanel>
            <TextBlock Margin="0,8,0,0">
              <Run Text="Purple bold SHA"/>
              <Run Text=" means the commit contains an SPP/submodule-pointer change."/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="8">
              <TextBlock Foreground="#FF7C3AED" FontWeight="Bold" Text="95977"/>
              <Border Width="16" Height="16" CornerRadius="8" Background="#FF7C3AED" BorderBrush="#FF5B21B6" BorderThickness="1">
                <Path Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource Icons.Submodule}" Fill="#FFF7D047"/>
              </Border>
            </StackPanel>
            <TextBlock Classes="small" Margin="0,8,0,0" Text="Grey ref chips appear because the commit is part of the filtered history, not because that ref itself matched your included filter." TextWrapping="Wrap"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="12" Height="12" Data="{StaticResource Icons.Info}"/>
      </Button>

      <Button Classes="icon_button toolbar_button" Width="56" Click="NavigateToHead">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Jump graph and selection to the current HEAD commit (active branch tip or detached HEAD)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Instantly return to your working position after exploring old commit history." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small italic" Margin="0,2,0,0" Text="Shortcut: Ctrl+H." Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="13" Height="13" Margin="0,2,0,0" HorizontalAlignment="Center" Data="{StaticResource Icons.Target}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Classes="toolbar_label" Text="Head"/>
        </StackPanel>
      </Button>
      <Button Width="0" Height="0" Click="NavigateToHead" IsVisible="False" HotKey="{OnPlatform Ctrl+H, macOS=⌘+⌥+H}"/>
      <Button Classes="icon_button toolbar_button"
              Width="56"
              Margin="4,0,0,0"
              Click="NavigateToSuperProjectPointer"
              IsVisible="{Binding HasSuperProjectPointer}"
              IsEnabled="{Binding HasSuperProjectPointer}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="Jump graph and selection to the SPP commit (super-project pointer for this submodule)." TextWrapping="Wrap" MaxWidth="420"/>
            <TextBlock Classes="small" Margin="0,4,0,0" Text="Example: Quickly locate the exact submodule commit currently pinned by the parent repository." Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" MaxWidth="420"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="13" Height="13" Margin="0,2,0,0" HorizontalAlignment="Center" Data="{StaticResource Icons.Submodule}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Classes="toolbar_label" Text="SPP"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
