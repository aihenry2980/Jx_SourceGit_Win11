<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.Repository"
             x:DataType="vm:Repository">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Brush.Accent" Color="{Binding AccentColor}"/>
    <SolidColorBrush x:Key="Brush.AccentHovered" Color="{Binding AccentHoveredColor}"/>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="RadioButton.history_order_segment">
      <Setter Property="Height" Value="18"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border CornerRadius="8"
                  Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="6,0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      </Style>
      <Style Selector="^ TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
      </Style>
      <Style Selector="^:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
      </Style>
      <Style Selector="^:checked TextBlock">
        <Setter Property="Foreground" Value="White"/>
      </Style>
    </Style>
    <Style Selector="ToggleButton.history_inline_toggle">
      <Setter Property="Height" Value="20"/>
      <Setter Property="MinWidth" Value="52"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource Brush.BG1}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ Path">
        <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
      </Style>
      <Style Selector="^ TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      </Style>
      <Style Selector="^:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      </Style>
      <Style Selector="^:checked TextBlock">
        <Setter Property="Foreground" Value="White"/>
      </Style>
      <Style Selector="^:checked Path">
        <Setter Property="Fill" Value="#FFFFE066"/>
      </Style>
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MinWidth="64" MaxWidth="500"/>
      <ColumnDefinition Width="{Binding SidebarSplitterWidth}"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left Panel -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*">
      <!-- Page Switcher for Left Contents (Dashboard or CommitSearch) -->
      <StackPanel Grid.Row="0" Margin="0,6" Height="24" HorizontalAlignment="Center" Orientation="Horizontal">
        <ToggleButton Classes="icon_button"
                      Width="24"
                      Height="24"
                      Margin="0,0,8,0"
                      IsChecked="{Binding IsLeftSidebarCompact, Mode=TwoWay}"
                      ToolTip.Tip="Collapse the left sidebar into icon-only mode for smaller displays">
          <Grid>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource Fonts.Monospace}"
                       FontSize="11"
                       FontWeight="Bold"
                       Text="&lt;&lt;"
                       IsVisible="{Binding !IsLeftSidebarCompact}"/>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource Fonts.Monospace}"
                       FontSize="11"
                       FontWeight="Bold"
                       Text="&gt;&gt;"
                       IsVisible="{Binding IsLeftSidebarCompact}"/>
          </Grid>
        </ToggleButton>

        <RadioButton Classes="switch_button"
                     Width="48"
                     GroupName="SearchGroup"
                     IsChecked="{Binding !IsSearchingCommits, Mode=OneWay}">
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{DynamicResource Text.Repository.Dashboard}" Foreground="{DynamicResource Brush.FG1}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+Shift+H, macOS=⌘+⇧+H}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
          </ToolTip.Tip>
          <Path Width="12" Height="12" Stretch="Fill" HorizontalAlignment="Center" Data="{StaticResource Icons.Home}"/>
        </RadioButton>

        <RadioButton Classes="switch_button"
                     Width="48"
                     GroupName="SearchGroup"
                     IsChecked="{Binding IsSearchingCommits, Mode=TwoWay}">
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{DynamicResource Text.Repository.Search}" Foreground="{DynamicResource Brush.FG1}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+Shift+F, macOS=⌘+⇧+F}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
          </ToolTip.Tip>
          <Path Width="12" Height="12" Stretch="Fill" HorizontalAlignment="Center" Data="{StaticResource Icons.Search}"/>
        </RadioButton>

        <Border Height="24"
                MinWidth="64"
                MaxWidth="170"
                Margin="8,0,0,0"
                Padding="10,0"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Popup}"
                BorderBrush="{DynamicResource Brush.Border0}"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding !IsLeftSidebarCompact}">
          <TextBlock Text="{Binding MachineName}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG1}"
                     VerticalAlignment="Center"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </Border>
      </StackPanel>

      <!-- Dashboard -->
      <ScrollViewer x:Name="DashboardScrollViewer"
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding !IsSearchingCommits}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <!-- Page Switcher for Right Panel -->
        <Border Grid.Row="0" Margin="8,0,4,0" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}" CornerRadius="6">
          <Border CornerRadius="6" ClipToBounds="True">
            <ListBox Background="Transparent" SelectedIndex="{Binding SelectedViewIndex, Mode=TwoWay}" SelectionMode="AlwaysSelected">
              <ListBox.Styles>
                <Style Selector="Path.icon">
                  <Setter Property="Width" Value="12"/>
                  <Setter Property="Height" Value="12"/>
                  <Setter Property="Margin" Value="8,0,6,0"/>
                  <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
                </Style>
                <Style Selector="TextBlock.header">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                </Style>
                <Style Selector="ListBoxItem">
                  <Setter Property="Height" Value="28"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="BorderThickness" Value="0,0,0,1"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
                </Style>
                <Style Selector="ListBoxItem:nth-last-child(1)">
                  <Setter Property="BorderThickness" Value="0"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected Grid.view_mode">
                  <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock.header">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
                </Style>
                <Style Selector="ListBoxItem:selected Path.icon">
                  <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
                </Style>
              </ListBox.Styles>

            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

              <ListBoxItem>
                <Grid Classes="view_mode" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                  <Path Grid.Column="0" Classes="icon" Data="{StaticResource Icons.Histories}"/>
                  <TextBlock Grid.Column="1" Classes="header" Text="{DynamicResource Text.Histories}" IsVisible="{Binding !IsLeftSidebarCompact}"/>

                  <ToggleButton Grid.Column="2"
                                Classes="line_path"
                                Width="26" Height="26"
                                Background="Transparent"
                                IsChecked="{Binding HighlightCurrentBranchOnlyInHistory, Mode=TwoWay}"
                                IsVisible="{Binding !IsLeftSidebarCompact}"
                                ToolTip.Tip="{DynamicResource Text.Repository.OnlyHighlightCurrentBranchInGraph}">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.LightOn}"/>
                  </ToggleButton>
                  <ToggleButton Grid.Column="3"
                                Classes="line_path"
                                Width="26" Height="26"
                                Background="Transparent"
                                IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=DisplayTimeAsPeriodInHistories, Mode=TwoWay}"
                                IsVisible="{Binding !IsLeftSidebarCompact}"
                                ToolTip.Tip="{DynamicResource Text.Repository.UseRelativeTimeInGraph}">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.Stopwatch}"/>
                  </ToggleButton>
                  <ToggleButton Grid.Column="4"
                                Classes="line_path"
                                Width="42" Height="26"
                                Background="Transparent"
                                IsChecked="{Binding OnlyShowSPPCommitsInHistory, Mode=TwoWay}"
                                IsVisible="{Binding !IsLeftSidebarCompact}"
                                ToolTip.Tip="Only show commits with SPP change">
                    <TextBlock FontSize="10" FontWeight="Bold" Text="SPP"/>
                  </ToggleButton>
                  <Button Grid.Column="5"
                          Classes="icon_button"
                          Width="26" Height="26"
                          IsVisible="{Binding !IsLeftSidebarCompact}"
                          Click="OnOpenAdvancedHistoriesOption"
                          ToolTip.Tip="{DynamicResource Text.Repository.MoreOptions}">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.More}"/>
                  </Button>
                </Grid>
              </ListBoxItem>

              <ListBoxItem IsVisible="{Binding !IsBare}" Height="46">
                <Grid Classes="view_mode" RowDefinitions="28,18" ColumnDefinitions="Auto,*,Auto">
                  <Path Grid.Column="0" Classes="icon" Data="{StaticResource Icons.Changes}"/>
                  <TextBlock Grid.Column="1" Classes="header" Text="{DynamicResource Text.WorkingCopy}" IsVisible="{Binding !IsLeftSidebarCompact}"/>
                  <StackPanel Grid.Column="2"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Spacing="4"
                              IsVisible="{Binding !IsLeftSidebarCompact}">
                    <Border Height="18"
                            Margin="6,0,0,0"
                            Padding="9,0"
                            CornerRadius="9"
                            VerticalAlignment="Center"
                            Background="#FFFF3B30"
                            BorderBrush="White"
                            BorderThickness="1">
                      <Border.IsVisible>
                        <Binding Path="LocalChangesCount" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
                      </Border.IsVisible>
                      <TextBlock Text="{Binding LocalChangesCount, Mode=OneWay}"
                                 Foreground="White"
                                 FontFamily="{DynamicResource Fonts.Monospace}"
                                 FontWeight="Bold"
                                 FontSize="10"/>
                    </Border>
                    <Path Width="12"
                          Height="12"
                          Margin="0,0,2,0"
                          VerticalAlignment="Center"
                          Data="{StaticResource Icons.Info}"
                          Fill="DarkOrange"
                          IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="icon_button"
                            Width="26"
                            Height="26"
                            Click="OnOpenLocalIgnoreConfigure"
                            ToolTip.Tip="Local Git Ignore">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.GitIgnore}"/>
                    </Button>
                    <Button Classes="icon_button"
                            Width="26"
                            Height="26"
                            Click="OnApplyLocalIgnoreRules"
                            ToolTip.Tip="Refresh Local Ignore">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.Refresh}"/>
                    </Button>
                    <Button Classes="icon_button"
                            Width="26"
                            Height="26"
                            Command="{Binding DiscardAllChanges}"
                            ToolTip.Tip="{DynamicResource Text.Repository.DiscardAll}">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.Undo}"/>
                    </Button>
                  </StackPanel>

                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Padding="0"
                          Background="Transparent"
                          BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Click="OnOpenRecursiveLocalChanges"
                          IsVisible="{Binding !IsLeftSidebarCompact}"
                          ToolTip.Tip="Show parent-repository changes and changed submodules recursively">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <Path Width="10"
                            Height="10"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource Brush.FG2}"
                            Data="{StaticResource Icons.Submodules}"/>
                      <TextBlock FontSize="10"
                                 Foreground="{DynamicResource Brush.FG2}"
                                 Text="Local changes recursively"/>
                    </StackPanel>
                  </Button>

                  <Button Grid.Row="1"
                          Grid.Column="2"
                          Classes="icon_button"
                          Width="24"
                          Height="18"
                          Margin="4,0,4,4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !IsLeftSidebarCompact}"
                          Click="OnRestoreCleanStateRecursively"
                          ToolTip.Tip="Restore clean state recursively">
                    <Path Width="11"
                          Height="11"
                          Fill="#FF7F1D1D"
                          Data="{StaticResource Icons.Clean}"/>
                  </Button>
                </Grid>
              </ListBoxItem>

              <ListBoxItem IsVisible="{Binding !IsBare}">
                <Grid Classes="view_mode" ColumnDefinitions="Auto,*,Auto,Auto">
                  <Path Grid.Column="0" Classes="icon" Data="{StaticResource Icons.Stashes}"/>
                  <TextBlock Grid.Column="1" Classes="header" Text="{DynamicResource Text.Stashes}" IsVisible="{Binding !IsLeftSidebarCompact}"/>
                  <Border Grid.Column="2"
                          Height="18"
                          Margin="6,0" Padding="9,0"
                          CornerRadius="9"
                          VerticalAlignment="Center"
                          Background="{DynamicResource Brush.Badge}">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsLeftSidebarCompact"/>
                        <Binding Path="StashesCount" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
                      </MultiBinding>
                    </Border.IsVisible>
                    <TextBlock Text="{Binding StashesCount, Mode=OneWay}"
                               Foreground="{DynamicResource Brush.BadgeFG}"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               FontSize="10"/>
                  </Border>
                  <Button Grid.Column="3"
                          Classes="icon_button"
                          Width="26" Height="26"
                          Command="{Binding ClearStashes}"
                          IsVisible="{Binding !IsLeftSidebarCompact}"
                          IsEnabled="{Binding StashesCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"
                          ToolTip.Tip="{DynamicResource Text.Repository.ClearStashes}">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.RemoveAll}"/>
                  </Button>
                </Grid>
              </ListBoxItem>

              <ListBoxItem IsVisible="{Binding !IsBare}">
                <Grid Classes="view_mode" ColumnDefinitions="Auto,*,Auto">
                  <Path Grid.Column="0" Classes="icon" Data="{StaticResource Icons.Submodules}"/>
                  <TextBlock Grid.Column="1" Classes="header" Text="Commit Flow" IsVisible="{Binding !IsLeftSidebarCompact}"/>
                  <Path Grid.Column="2"
                        Width="12"
                        Height="12"
                        Margin="6,0,10,0"
                        Data="{StaticResource Icons.Commit}"
                        Fill="{DynamicResource Brush.FG2}"
                        IsVisible="{Binding !IsLeftSidebarCompact}"/>
                </Grid>
              </ListBoxItem>
            </ListBox>
          </Border>
        </Border>

        <!-- Filter Branches/Tags/Submodules -->
        <TextBox Grid.Row="1"
                 Height="26"
                 Margin="8,6,4,0"
                 BorderThickness="1"
                 CornerRadius="4"
                 BorderBrush="{DynamicResource Brush.Border2}"
                 Watermark="{DynamicResource Text.Repository.Filter}"
                 Text="{Binding Filter, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 IsVisible="{Binding !IsLeftSidebarCompact}">
          <TextBox.InnerLeftContent>
            <Path Width="14" Height="14"
                  Margin="6,0,0,0"
                  Fill="{DynamicResource Brush.FG2}"
                  Data="{StaticResource Icons.Search}"/>
          </TextBox.InnerLeftContent>

          <TextBox.InnerRightContent>
            <Button Classes="icon_button"
                    Width="16"
                    Margin="0,0,6,0"
                    Command="{Binding ClearFilter}"
                    IsVisible="{Binding Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    HorizontalAlignment="Right">
              <Path Width="14" Height="14"
                    Margin="0,1,0,0"
                    Fill="{DynamicResource Brush.FG1}"
                    Data="{StaticResource Icons.Clear}"/>
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>

        <ToggleButton Grid.Row="2"
                      Classes="group_expander"
                      Margin="8,6,4,0"
                      IsVisible="{Binding !IsLeftSidebarCompact}"
                      IsChecked="{Binding IsPresetBranchFilterEditorExpanded, Mode=TwoWay}">
          <Grid ColumnDefinitions="16,*,Auto">
            <Path Grid.Column="0"
                  Width="12"
                  Height="12"
                  HorizontalAlignment="Left"
                  Data="{StaticResource Icons.Filter}"
                  Fill="{DynamicResource Brush.FG2}"/>
            <TextBlock Grid.Column="1"
                       Classes="group_header_label"
                       Text="{DynamicResource Text.Repository.BranchesVisibility.PresetHeader}"/>
            <TextBlock Grid.Column="2"
                       Classes="group_header_label"
                       Margin="8,0,0,0"
                       Text="{Binding PresetBranchFilterSummary}"/>
          </Grid>
        </ToggleButton>

        <Border Grid.Row="3"
                Margin="8,0,4,0"
                Padding="10,8"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border2}">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!IsLeftSidebarCompact"/>
              <Binding Path="IsPresetBranchFilterEditorExpanded"/>
            </MultiBinding>
          </Border.IsVisible>
          <StackPanel Orientation="Vertical">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Classes="small"
                         FontWeight="Bold"
                         Foreground="#FF10893E"
                         Text="{DynamicResource Text.Repository.BranchesVisibility.ExactNames}"/>
              <Button Grid.Column="1"
                      Classes="flat"
                      Padding="8,2"
                      Click="OnClearPresetBranchExactNames">
                <TextBlock Classes="small" Text="Clear"/>
              </Button>
            </Grid>
            <Border Margin="0,4,0,0"
                    Padding="6,4"
                    CornerRadius="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border1}"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnPresetBranchFilterTextBoxDragOver"
                    DragDrop.Drop="OnDropToPresetBranchExactNames">
              <StackPanel Orientation="Vertical" Spacing="2">
                <ItemsControl IsVisible="{Binding PresetBranchExactNames, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"
                              ItemsSource="{Binding PresetBranchExactNames, Converter={x:Static c:StringConverters.ToPresetBranchRuleTokens}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,4,4"
                              MaxWidth="{Binding $parent[ItemsControl].Bounds.Width, Converter={x:Static c:DoubleConverters.ToRuleChipMaxWidth}}"
                              Padding="8,2,4,2"
                              CornerRadius="10"
                              BorderThickness="1"
                              BorderBrush="#FF10893E"
                              Background="#1A10893E"
                              DoubleTapped="OnPresetBranchRuleDoubleTapped"
                              ContextRequested="OnPresetBranchRuleContextRequested">
                        <Grid ColumnDefinitions="*,18">
                          <TextBlock Grid.Column="0"
                                     VerticalAlignment="Center"
                                     Text="{Binding .}"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding .}"/>
                          <Button Grid.Column="1"
                                  Classes="flat"
                                  Width="12"
                                  Height="12"
                                  MinWidth="12"
                                  Margin="6,0,0,0"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  Tag="{Binding .}"
                                  Click="OnRemovePresetBranchExactName">
                            <Path Width="7"
                                  Height="7"
                                  Data="{StaticResource Icons.Close}"
                                  Fill="{DynamicResource Brush.FG2}"/>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="PresetBranchExactNameInputBox"
                         MinHeight="26"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         CornerRadius="3"
                         Watermark="{DynamicResource Text.Repository.BranchesVisibility.ExactNames.Placeholder}"
                         ToolTip.Tip="{DynamicResource Text.Repository.BranchesVisibility.EditorHint}"
                         TextChanged="OnPresetBranchInputTextChanged"
                         KeyDown="OnPresetBranchExactNameInputKeyDown"/>
              </StackPanel>
            </Border>

            <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Classes="small"
                         FontWeight="Bold"
                         Foreground="#FF0078D7"
                         Text="{DynamicResource Text.Repository.BranchesVisibility.ContainsPatterns}"/>
              <Button Grid.Column="1"
                      Classes="flat"
                      Padding="8,2"
                      Click="OnClearPresetBranchContainsPatterns">
                <TextBlock Classes="small" Text="Clear"/>
              </Button>
            </Grid>
            <Border Margin="0,4,0,0"
                    Padding="6,4"
                    CornerRadius="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border1}"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnPresetBranchFilterTextBoxDragOver"
                    DragDrop.Drop="OnDropToPresetBranchContainsPatterns">
              <StackPanel Orientation="Vertical" Spacing="2">
                <ItemsControl IsVisible="{Binding PresetBranchContainsPatterns, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"
                              ItemsSource="{Binding PresetBranchContainsPatterns, Converter={x:Static c:StringConverters.ToPresetBranchRuleTokens}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,4,4"
                              MaxWidth="{Binding $parent[ItemsControl].Bounds.Width, Converter={x:Static c:DoubleConverters.ToRuleChipMaxWidth}}"
                              Padding="8,2,4,2"
                              CornerRadius="10"
                              BorderThickness="1"
                              BorderBrush="#FF0078D7"
                              Background="#1A0078D7"
                              DoubleTapped="OnPresetBranchRuleDoubleTapped"
                              ContextRequested="OnPresetBranchRuleContextRequested">
                        <Grid ColumnDefinitions="*,18">
                          <TextBlock Grid.Column="0"
                                     VerticalAlignment="Center"
                                     Text="{Binding .}"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding .}"/>
                          <Button Grid.Column="1"
                                  Classes="flat"
                                  Width="12"
                                  Height="12"
                                  MinWidth="12"
                                  Margin="6,0,0,0"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  Tag="{Binding .}"
                                  Click="OnRemovePresetBranchContainsPattern">
                            <Path Width="7"
                                  Height="7"
                                  Data="{StaticResource Icons.Close}"
                                  Fill="{DynamicResource Brush.FG2}"/>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="PresetBranchContainsPatternInputBox"
                         MinHeight="26"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         CornerRadius="3"
                         Watermark="{DynamicResource Text.Repository.BranchesVisibility.ContainsPatterns.Placeholder}"
                         ToolTip.Tip="{DynamicResource Text.Repository.BranchesVisibility.EditorHint}"
                         TextChanged="OnPresetBranchInputTextChanged"
                         KeyDown="OnPresetBranchContainsPatternInputKeyDown"/>
              </StackPanel>
            </Border>

            <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Classes="small"
                         FontWeight="Bold"
                         Foreground="#FFD13438"
                         Text="{DynamicResource Text.Repository.BranchesVisibility.ExcludeNames}"/>
              <Button Grid.Column="1"
                      Classes="flat"
                      Padding="8,2"
                      Click="OnClearPresetBranchExcludeNames">
                <TextBlock Classes="small" Text="Clear"/>
              </Button>
            </Grid>
            <Border Margin="0,4,0,0"
                    Padding="6,4"
                    CornerRadius="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border1}"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnPresetBranchFilterTextBoxDragOver"
                    DragDrop.Drop="OnDropToPresetBranchExcludeNames">
              <StackPanel Orientation="Vertical" Spacing="2">
                <ItemsControl IsVisible="{Binding PresetBranchExcludeNames, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"
                              ItemsSource="{Binding PresetBranchExcludeNames, Converter={x:Static c:StringConverters.ToPresetBranchRuleTokens}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,4,4"
                              MaxWidth="{Binding $parent[ItemsControl].Bounds.Width, Converter={x:Static c:DoubleConverters.ToRuleChipMaxWidth}}"
                              Padding="8,2,4,2"
                              CornerRadius="10"
                              BorderThickness="1"
                              BorderBrush="#FFD13438"
                              Background="#1AD13438"
                              DoubleTapped="OnPresetBranchRuleDoubleTapped"
                              ContextRequested="OnPresetBranchRuleContextRequested">
                        <Grid ColumnDefinitions="*,18">
                          <TextBlock Grid.Column="0"
                                     VerticalAlignment="Center"
                                     Text="{Binding .}"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding .}"/>
                          <Button Grid.Column="1"
                                  Classes="flat"
                                  Width="12"
                                  Height="12"
                                  MinWidth="12"
                                  Margin="6,0,0,0"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  Tag="{Binding .}"
                                  Click="OnRemovePresetBranchExcludeName">
                            <Path Width="7"
                                  Height="7"
                                  Data="{StaticResource Icons.Close}"
                                  Fill="{DynamicResource Brush.FG2}"/>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="PresetBranchExcludeNameInputBox"
                         MinHeight="26"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         CornerRadius="3"
                         Watermark="{DynamicResource Text.Repository.BranchesVisibility.ExcludeNames.Placeholder}"
                         ToolTip.Tip="{DynamicResource Text.Repository.BranchesVisibility.EditorHint}"
                         TextChanged="OnPresetBranchInputTextChanged"
                         KeyDown="OnPresetBranchExcludeNameInputKeyDown"/>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Classes="flat primary"
                      Padding="10,4"
                      Click="OnApplyPresetBranchFilter">
                <TextBlock Text="{DynamicResource Text.Repository.BranchesVisibility.ApplyFilter}"/>
              </Button>

              <Button Classes="flat"
                      Margin="8,0,0,0"
                      Padding="10,4"
                      Click="OnToggleShowAllBranches">
                <Grid>
                  <TextBlock Text="{DynamicResource Text.Repository.BranchesVisibility.UsePresetFilter}"
                             IsVisible="{Binding IsShowingAllBranches}"/>
                  <TextBlock Text="{DynamicResource Text.Repository.BranchesVisibility.ShowAll}"
                             IsVisible="{Binding !IsShowingAllBranches}"/>
                </Grid>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="8,6,4,0"
                Padding="10,8"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border2}"
                IsVisible="{Binding ShouldShowBranchPresetEmptyState}">
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Repository.BranchesVisibility.Empty}"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Classes="flat"
                      Padding="10,4"
                      Click="OnSetPresetBranchFilter">
                <TextBlock Text="{DynamicResource Text.Repository.BranchesVisibility.SetPresetFilters}"/>
              </Button>

              <Button Classes="flat"
                      Margin="8,0,0,0"
                      Padding="10,4"
                      Click="OnShowAllBranches">
                <TextBlock Text="{DynamicResource Text.Repository.BranchesVisibility.ShowAll}"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <Grid Grid.Row="5" x:Name="LeftSidebarGroups" Margin="0,4,0,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" SizeChanged="OnLeftSidebarSizeChanged" IsVisible="{Binding !IsLeftSidebarCompact}">
          <!-- Rebase Base Branch -->
          <Border Grid.Row="7"
                  Height="30"
                  Margin="20,3,4,2"
                  Padding="10,0"
                  CornerRadius="7"
                  Background="#18FFC107"
                  BorderBrush="#66FFC107"
                  BorderThickness="1"
                  IsVisible="{Binding RebaseBaseBranchDisplayName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Cursor="Hand"
                  ContextRequested="OnRebaseBaseBranchContextRequested"
                  DoubleTapped="OnRebaseBaseBranchDoubleTapped">
            <ToolTip.Tip>
              <StackPanel>
                <TextBlock FontWeight="Bold" Text="Rebase Base Branch"/>
                <TextBlock Classes="small"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.FG2}"
                           Text="Double-click to select its tip commit."/>
              </StackPanel>
            </ToolTip.Tip>
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0"
                    Width="12" Height="12"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Data="{StaticResource Icons.Star}"
                    Fill="#FFFFC107"
                    Stroke="#FF6D4C00"
                    StrokeThickness="0.8"/>
              <Grid Grid.Column="1"
                    ColumnDefinitions="*,Auto"
                    VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           FontWeight="SemiBold"
                           Text="{Binding RebaseBaseBranchDisplayName}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding RebaseBaseBranchDisplayName}"/>
                <TextBlock Grid.Column="1"
                           Margin="4,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="#FFD32F2F"
                           Text="(not exist)"
                           IsVisible="{Binding IsRebaseBaseBranchMissing}"/>
              </Grid>
            </Grid>
          </Border>

          <!-- Local Branches -->
          <ToggleButton Grid.Row="8" Classes="group_expander primary_group" IsChecked="{Binding IsLocalBranchGroupExpanded, Mode=TwoWay}">
            <Grid ColumnDefinitions="16,*,Auto,Auto">
              <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Local}" Fill="{DynamicResource Brush.FG2}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.LocalBranches}"/>
                <TextBlock Classes="group_header_label" Text="{Binding LocalBranchesCount, StringFormat='({0})'}" Margin="4,0,0,0"/>
              </StackPanel>
              <Button Grid.Column="2"
                      Classes="icon_button"
                      Width="14"
                      Margin="8,0,0,0"
                      Click="OnOpenSortLocalBranchMenu"
                      ToolTip.Tip="{DynamicResource Text.Repository.BranchSort}">
                <Grid>
                  <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByName}" IsVisible="{Binding IsSortingLocalBranchByName, Mode=OneWay}"/>
                  <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByTime}" IsVisible="{Binding !IsSortingLocalBranchByName, Mode=OneWay}"/>
                </Grid>
              </Button>
              <Button Grid.Column="3" Classes="icon_button" Width="14" Margin="8,0" Command="{Binding CreateNewBranch}" ToolTip.Tip="{DynamicResource Text.Repository.NewBranch}">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Branch.Add}"/>
              </Button>
            </Grid>
          </ToggleButton>
          <v:BranchTree Grid.Row="9"
                        x:Name="LocalBranchTree"
                        Height="0"
                        Margin="8,0,4,0"
                        Nodes="{Binding LocalBranchTrees}"
                        IsVisible="{Binding IsLocalBranchGroupExpanded}"
                        SelectionChanged="OnLocalBranchTreeSelectionChanged"
                        RowsChanged="OnLeftSidebarRowsChanged"/>

          <!-- Submodules -->
          <ToggleButton Grid.Row="10" Classes="group_expander primary_group" IsChecked="{Binding IsSubmoduleGroupExpanded, Mode=TwoWay}">
            <Grid ColumnDefinitions="16,*,Auto,Auto,Auto,Auto">
              <Path Grid.Column="0" Width="10" Height="10" Margin="2,0,0,0" HorizontalAlignment="Left" Data="{StaticResource Icons.Submodules}" Fill="{DynamicResource Brush.FG2}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Submodules}"/>
                <TextBlock Classes="group_header_label" Text="{Binding SubmodulesHeaderCountText}" Margin="4,0,0,0"/>
              </StackPanel>
              <ToggleButton Grid.Column="2"
                            Classes="show_as_tree"
                            Width="14"
                            IsChecked="{Binding ShowSubmodulesAsTree, Mode=TwoWay}"
                            IsVisible="{Binding Submodules, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                            ToolTip.Tip="{DynamicResource Text.Repository.ShowSubmodulesAsTree}"/>
              <Button Grid.Column="3"
                      Classes="icon_button"
                      Width="14"
                      Margin="8,0"
                      Click="OnRefreshSubmodules"
                      ToolTip.Tip="Refresh submodule status">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Refresh}"/>
              </Button>
              <Button Grid.Column="4"
                      Classes="icon_button"
                      Width="14"
                      Margin="8,0"
                      Command="{Binding UpdateSubmodules}"
                      IsVisible="{Binding Submodules, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                      ToolTip.Tip="{DynamicResource Text.Repository.Submodules.Update}">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Loading}"/>
              </Button>
              <Button Grid.Column="5"
                      Classes="icon_button"
                      Width="14"
                      Margin="0,0,8,0"
                      Command="{Binding AddSubmodule}"
                      ToolTip.Tip="{DynamicResource Text.Repository.Submodules.Add}">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Submodule.Add}"/>
              </Button>
            </Grid>
          </ToggleButton>
          <v:SubmodulesView Grid.Row="11"
                            x:Name="SubmoduleList"
                            Height="0"
                            Margin="8,0,4,0"
                            Content="{Binding VisibleSubmodules}"
                            RowsChanged="OnLeftSidebarRowsChanged"
                            Focusable="False"
                            IsVisible="{Binding IsSubmoduleGroupExpanded, Mode=OneWay}"/>

          <!-- Not frequently used -->
          <ToggleButton Grid.Row="0" Classes="group_expander" IsChecked="{Binding IsInfrequentGroupExpanded, Mode=TwoWay}">
            <Grid ColumnDefinitions="16,*,Auto">
              <Path Grid.Column="0" Width="12" Height="12" HorizontalAlignment="Left" Data="{StaticResource Icons.More}" Fill="{DynamicResource Brush.FG2}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Classes="group_header_label" Text="NOT FREQUENTLY USED"/>
                <TextBlock Classes="group_header_label" Text="{Binding Remotes, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                <TextBlock Classes="group_header_label" Text=" remote"/>
                <TextBlock Classes="group_header_label" Text="{Binding Tags, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                <TextBlock Classes="group_header_label" Text=" tag"/>
                <TextBlock Classes="group_header_label" Text="{Binding Worktrees, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                <TextBlock Classes="group_header_label" Text=" worktree"/>
              </StackPanel>
            </Grid>
          </ToggleButton>

          <!-- Remotes -->
          <ToggleButton Grid.Row="1" Classes="group_expander" IsChecked="{Binding IsRemoteGroupExpanded, Mode=TwoWay}" IsVisible="{Binding IsInfrequentGroupExpanded}">
            <Grid ColumnDefinitions="16,*,Auto,Auto">
              <Path Grid.Column="0" Width="12" Height="12" HorizontalAlignment="Left" Data="{StaticResource Icons.Remotes}" Fill="{DynamicResource Brush.FG2}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Remotes}"/>
                <TextBlock Classes="group_header_label" Text="{Binding Remotes, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
              </StackPanel>
              <Button Grid.Column="2"
                      Classes="icon_button"
                      Width="14"
                      Margin="8,0,0,0"
                      Click="OnOpenSortRemoteBranchMenu"
                      ToolTip.Tip="{DynamicResource Text.Repository.BranchSort}">
                <Grid>
                  <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByName}" IsVisible="{Binding IsSortingRemoteBranchByName, Mode=OneWay}"/>
                  <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByTime}" IsVisible="{Binding !IsSortingRemoteBranchByName, Mode=OneWay}"/>
                </Grid>
              </Button>
              <Button Grid.Column="3" Classes="icon_button" Width="14" Margin="8,0" Command="{Binding AddRemote}" ToolTip.Tip="{DynamicResource Text.Repository.Remotes.Add}">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Remote.Add}"/>
              </Button>
            </Grid>
          </ToggleButton>
          <v:BranchTree Grid.Row="2"
                        x:Name="RemoteBranchTree"
                        Height="0"
                        Margin="8,0,4,0"
                        Nodes="{Binding RemoteBranchTrees}"
                        SelectionChanged="OnRemoteBranchTreeSelectionChanged"
                        RowsChanged="OnLeftSidebarRowsChanged">
            <v:BranchTree.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsInfrequentGroupExpanded"/>
                <Binding Path="IsRemoteGroupExpanded"/>
              </MultiBinding>
            </v:BranchTree.IsVisible>
          </v:BranchTree>

          <!-- Tags -->
          <ToggleButton Grid.Row="3" Classes="group_expander" IsChecked="{Binding IsTagGroupExpanded, Mode=TwoWay}" IsVisible="{Binding IsInfrequentGroupExpanded}">
            <Grid ColumnDefinitions="16,*,Auto,Auto,Auto">
              <Path Grid.Column="0" Width="11" Height="11" Margin="2,1,0,0" HorizontalAlignment="Left" Data="{StaticResource Icons.Tags}" Fill="{DynamicResource Brush.FG2}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Tags}"/>
                <TextBlock Classes="group_header_label" Text="{Binding Tags, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
              </StackPanel>
              <ToggleButton Grid.Column="2"
                            Classes="show_as_tree"
                            Width="14"
                            IsChecked="{Binding ShowTagsAsTree, Mode=TwoWay}"
                            ToolTip.Tip="{DynamicResource Text.Repository.ShowTagsAsTree}"/>
              <Button Grid.Column="3"
                      Classes="icon_button"
                      Width="14"
                      Margin="8,0,0,0"
                      Click="OnOpenSortTagMenu"
                      ToolTip.Tip="{DynamicResource Text.Repository.Tags.Sort}">
                <Grid>
                  <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByName}" IsVisible="{Binding IsSortingTagsByName, Mode=OneWay}"/>
                  <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByTime}" IsVisible="{Binding !IsSortingTagsByName, Mode=OneWay}"/>
                </Grid>
              </Button>
              <Button Grid.Column="4"
                      Classes="icon_button"
                      Width="14"
                      Margin="8,0"
                      Command="{Binding CreateNewTag}"
                      ToolTip.Tip="{DynamicResource Text.Repository.Tags.Add}">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Tag.Add}"/>
              </Button>
            </Grid>
          </ToggleButton>
          <v:TagsView Grid.Row="4"
                      x:Name="TagsList"
                      Height="0"
                      Margin="8,0,4,0"
                      Background="Transparent"
                      Content="{Binding VisibleTags}"
                      Focusable="False"
                      SelectionChanged="OnTagsSelectionChanged"
                      RowsChanged="OnLeftSidebarRowsChanged">
            <v:TagsView.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsInfrequentGroupExpanded"/>
                <Binding Path="IsTagGroupExpanded"/>
              </MultiBinding>
            </v:TagsView.IsVisible>
          </v:TagsView>

          <!-- Worktrees -->
          <ToggleButton Grid.Row="5" Classes="group_expander" IsChecked="{Binding IsWorktreeGroupExpanded, Mode=TwoWay}" IsVisible="{Binding IsInfrequentGroupExpanded}">
            <Grid ColumnDefinitions="16,*,Auto,Auto">
              <Path Grid.Column="0" Width="11" Height="11" Margin="1,0,0,0" HorizontalAlignment="Left" Data="{StaticResource Icons.Worktrees}" Fill="{DynamicResource Brush.FG2}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Worktrees}"/>
                <TextBlock Classes="group_header_label" Text="{Binding Worktrees, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
              </StackPanel>
              <Button Grid.Column="2"
                      Classes="icon_button"
                      Width="14"
                      Margin="8,0"
                      Click="OnPruneWorktrees"
                      IsVisible="{Binding Worktrees, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                      ToolTip.Tip="{DynamicResource Text.Repository.Worktrees.Prune}">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Loading}"/>
              </Button>
              <Button Grid.Column="3"
                      Classes="icon_button"
                      Width="14"
                      Margin="0,0,9,0"
                      Command="{Binding AddWorktree}"
                      ToolTip.Tip="{DynamicResource Text.Repository.Worktrees.Add}">
                <Path Width="11" Height="11" Data="{StaticResource Icons.Worktree.Add}"/>
              </Button>
            </Grid>
          </ToggleButton>
          <ListBox Grid.Row="6"
                   x:Name="WorktreeList"
                   Height="0"
                   Margin="12,0,4,0"
                   Classes="repo_left_content_list"
                   ItemsSource="{Binding Worktrees}"
                   SelectionMode="Single"
                   ContextRequested="OnWorktreeContextRequested"
                   DoubleTapped="OnWorktreeDoubleTapped"
                   PropertyChanged="OnWorktreeListPropertyChanged"
                   >
            <ListBox.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsInfrequentGroupExpanded"/>
                <Binding Path="IsWorktreeGroupExpanded"/>
              </MultiBinding>
            </ListBox.IsVisible>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="CornerRadius" Value="4"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:Worktree">
                <Border Height="24"
                        Background="Transparent"
                        DoubleTapped="OnWorktreeDoubleTapped"
                        ContextRequested="OnWorktreeContextRequested"
                        ToolTip.Placement="Right">
                  <ToolTip.Tip>
                    <StackPanel Orientation="Vertical">
                      <StackPanel Orientation="Horizontal">
                        <v:WorktreeIcon Width="12" Height="12"/>
                        <TextBlock FontWeight="Bold" Margin="8,0,0,0" Text="{Binding Name, Mode=OneWay}"/>
                      </StackPanel>

                      <Grid RowDefinitions="24,24,24" ColumnDefinitions="Auto,16,Auto,Auto" Margin="0,8,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Classes="info_label"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{DynamicResource Text.Worktree.Branch}"/>
                        <Path Grid.Row="0" Grid.Column="2"
                              Width="14" Height="14"
                              Margin="2,0,0,0"
                              Data="{StaticResource Icons.Branch}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Margin="6,0,0,0"
                                   Text="{Binding Branch, Mode=OneWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Classes="info_label"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{DynamicResource Text.Worktree.Path}"/>
                        <Path Grid.Row="1" Grid.Column="2"
                              Width="14" Height="14"
                              Margin="2,0,0,0"
                              Data="{StaticResource Icons.Folder.Open}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Margin="6,0,0,0"
                                   Text="{Binding FullPath, Mode=OneWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Classes="info_label"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{DynamicResource Text.Worktree.Head}"/>
                        <Path Grid.Row="2" Grid.Column="2"
                              Width="14" Height="14"
                              Data="{StaticResource Icons.Commit}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3"
                                   Margin="6,0,0,0"
                                   Text="{Binding Head, Mode=OneWay, Converter={x:Static c:StringConverters.ToShortSHA}}"/>
                      </Grid>
                    </StackPanel>
                  </ToolTip.Tip>
                  <Grid ColumnDefinitions="Auto,Auto,*,22" VerticalAlignment="Center">
                    <v:WorktreeDepthIcon Grid.Column="0" Brush="{DynamicResource Brush.Border1}"/>
                    <v:WorktreeIcon Grid.Column="1"
                                    Width="10" Height="10"
                                    Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource Brush.FG2}"
                               TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Name, Mode=OneWay}"
                           FontWeight="{Binding IsCurrent, Mode=OneWay, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"
                           Foreground="{DynamicResource Brush.FG1}"/>
                      <Run Text="{Binding DisplayPath, Mode=OneWay}"/>
                    </TextBlock>
                    <Path Grid.Column="3"
                          Width="10" Height="10"
                          Margin="4,0,0,0"
                          Data="{StaticResource Icons.Lock}"
                          Fill="{DynamicResource Brush.FG2}"
                          IsVisible="{Binding IsLocked, Mode=OneWay}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
      </ScrollViewer>

      <!-- Commit Search Panel -->
      <Grid Grid.Row="1" RowDefinitions="Auto,26,*" Margin="8,0,4,8" IsVisible="{Binding IsSearchingCommits}" PropertyChanged="OnSearchCommitPanelPropertyChanged">
        <!-- Search Input Box -->
        <Grid Grid.Row="0" Height="26" Margin="0,4,0,0">
          <TextBox x:Name="TxtSearchCommitsBox"
                   Height="24"
                   BorderThickness="1"
                   BorderBrush="{DynamicResource Brush.Border2}"
                   Background="{DynamicResource Brush.Contents}"
                   CornerRadius="12"
                   Watermark="{DynamicResource Text.Repository.Search}"
                   Text="{Binding SearchCommitContext.Filter, Mode=TwoWay}"
                   VerticalContentAlignment="Center"
                   KeyDown="OnSearchKeyDown">
            <TextBox.InnerLeftContent>
              <Path Width="14" Height="14"
                    Margin="6,0,0,0"
                    Fill="{DynamicResource Brush.FG2}"
                    Data="{StaticResource Icons.Search}"/>
            </TextBox.InnerLeftContent>

            <TextBox.InnerRightContent>
              <Button Classes="icon_button"
                      Width="16"
                      Margin="0,0,6,0"
                      Click="OnClearSearchCommitFilter"
                      IsVisible="{Binding SearchCommitContext.Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      HorizontalAlignment="Right">
                <Path Width="14" Height="14"
                      Margin="0,1,0,0"
                      Fill="{DynamicResource Brush.FG1}"
                      Data="{StaticResource Icons.Clear}"/>
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <Popup PlacementTarget="{Binding #TxtSearchCommitsBox}"
                 Placement="BottomEdgeAlignedLeft"
                 HorizontalOffset="-8" VerticalOffset="-6">
            <Popup.IsOpen>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SearchCommitContext.Suggestions" Converter="{x:Static c:ListConverters.IsNotNullOrEmpty}"/>
                <Binding Path="$parent[Window].IsActive"/>
              </MultiBinding>
            </Popup.IsOpen>

            <Border Margin="8" VerticalAlignment="Top" Effect="drop-shadow(0 0 8 #80000000)">
              <Border Padding="4"
                      CornerRadius="4"
                      Background="{DynamicResource Brush.Popup}"
                      BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}">
                <v:ListBoxEx x:Name="SearchSuggestionBox"
                             Background="Transparent"
                             SelectionMode="Single"
                             ItemsSource="{Binding SearchCommitContext.Suggestions}"
                             MaxHeight="400"
                             Focusable="True"
                             KeyDown="OnSearchSuggestionBoxKeyDown">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="MinHeight" Value="26"/>
                      <Setter Property="CornerRadius" Value="4"/>
                    </Style>

                    <Style Selector="ListBox">
                      <Setter Property="FocusAdorner">
                        <FocusAdornerTemplate>
                          <Grid/>
                        </FocusAdornerTemplate>
                      </Setter>
                    </Style>
                  </ListBox.Styles>

                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>

                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8,4" Height="42" Background="Transparent" Tapped="OnSearchSuggestionTapped">
                        <ContentControl Content="{Binding}" IsHitTestVisible="False">
                          <ContentControl.DataTemplates>
                            <DataTemplate DataType="x:String">
                              <Grid ColumnDefinitions="Auto,*">
                                <Path Width="24" Height="24" Data="{StaticResource Icons.File}"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0" Orientation="Vertical" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Converter={x:Static c:PathConverters.PureFileName}}"/>
                                  <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Converter={x:Static c:PathConverters.PureDirectoryName}}"/>
                                </StackPanel>
                              </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="m:User">
                              <Grid ColumnDefinitions="Auto,*">
                                <v:Avatar Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" User="{Binding}"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0" Orientation="Vertical" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name, Mode=OneWay}"/>
                                  <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Email, Mode=OneWay}"/>
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ContentControl.DataTemplates>
                        </ContentControl>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </v:ListBoxEx>
              </Border>
            </Border>
          </Popup>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
          <ComboBox MinHeight="24" Height="24"
                    Padding="4,0"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding SearchCommitContext.Method, Mode=TwoWay}">
            <ComboBox.Items>
              <TextBlock Text="{DynamicResource Text.Repository.Search.BySHA}"/>
              <TextBlock Text="{DynamicResource Text.Repository.Search.ByAuthor}"/>
              <TextBlock Text="{DynamicResource Text.Repository.Search.ByMessage}"/>
              <TextBlock Text="{DynamicResource Text.Repository.Search.ByPath}"/>
              <TextBlock Text="{DynamicResource Text.Repository.Search.ByContent}"/>
            </ComboBox.Items>
          </ComboBox>

          <CheckBox Height="24"
                    Margin="4,0,0,0"
                    IsChecked="{Binding SearchCommitContext.OnlySearchCurrentBranch, Mode=TwoWay}"
                    IsVisible="{Binding SearchCommitContext.Method, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
            <TextBlock Text="{DynamicResource Text.Repository.Search.InCurrentBranch}"/>
          </CheckBox>
        </StackPanel>

        <ListBox Grid.Row="2"
                 Margin="0,8,0,0"
                 Padding="4"
                 ItemsSource="{Binding SearchCommitContext.Results}"
                 SelectionMode="Single"
                 SelectedItem="{Binding SearchCommitContext.Selected, Mode=TwoWay}"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource Brush.Border2}"
                 Background="{DynamicResource Brush.Contents}"
                 CornerRadius="4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Grid.IsSharedSizeScope="True">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Margin" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Height" Value="28"/>
              <Setter Property="CornerRadius" Value="4"/>
            </Style>
          </ListBox.Styles>

          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>

          <ListBox.ItemTemplate>
            <DataTemplate DataType="m:Commit">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="SearchCommitTimeColumn"/>
                </Grid.ColumnDefinitions>
                <v:Avatar Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" User="{Binding Author}"/>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                  <Path Grid.Column="0" Width="14" Height="14" Margin="0,2,2,0" Data="{StaticResource Icons.Check}" Fill="Green" IsVisible="{Binding IsMerged, Mode=OneWay}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Subject}" Margin="2,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock Grid.Column="2"
                           Margin="4,0"
                           Foreground="{DynamicResource Brush.FG2}"
                           Text="{Binding CommitterTimeShortStr}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Path Grid.Row="2"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="48" Height="48"
              Data="{StaticResource Icons.Empty}"
              Fill="{DynamicResource Brush.FG2}">
          <Path.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="SearchCommitContext.Results" Converter="{x:Static c:ListConverters.IsNullOrEmpty}"/>
              <Binding Path="SearchCommitContext.IsQuerying" Converter="{x:Static BoolConverters.Not}"/>
            </MultiBinding>
          </Path.IsVisible>
        </Path>

        <v:LoadingIcon Grid.Row="2"
                       Width="48" Height="48"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding SearchCommitContext.IsQuerying}"/>
      </Grid>
    </Grid>

    <!-- Splitter -->
    <GridSplitter Grid.Column="1"
                  MinWidth="1"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0,0,1,0"
                  BorderBrush="{DynamicResource Brush.Border0}"/>

    <!-- Right -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">
      <Grid Grid.Row="0" Height="28" ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource Brush.Conflict}" IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ContentControl Grid.Column="0" Margin="8,0" Content="{Binding InProgressContext}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="m:Commit">
              <StackPanel MinWidth="400" Orientation="Vertical">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <v:Avatar Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False" User="{Binding Author}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Author.Name}" Margin="8,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding CommitterTimeStr}" Foreground="{DynamicResource Brush.FG2}" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Margin="0,8,0,0" Text="{Binding Subject}" TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="vm:CherryPickInProgress">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.CherryPick}"/>
                  <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.CherryPick.Head}"/>
                  <TextBlock FontWeight="Bold"
                             Margin="4,0,0,0"
                             Foreground="DarkOrange"
                             FontFamily="{DynamicResource Fonts.Monospace}"
                             Text="{Binding Head.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                             ToolTip.Tip="{Binding Head}"/>
                </StackPanel>

                <Button Grid.Column="1" Classes="flat" FontWeight="Regular" BorderThickness="0" Content="{DynamicResource Text.Repository.Skip}" Padding="8,2" Click="OnSkipInProgress"/>
              </Grid>
            </DataTemplate>

            <DataTemplate DataType="vm:RebaseInProgress">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Rebase}"/>
                  <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}"
                             Text="{DynamicResource Text.InProgress.Rebase.StoppedAt}"
                             IsVisible="{Binding StoppedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock FontWeight="Bold"
                             Margin="4,0,0,0"
                             Foreground="DarkOrange"
                             Text="{Binding StoppedAt.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                             FontFamily="{DynamicResource Fonts.Monospace}"
                             IsVisible="{Binding StoppedAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                             ToolTip.Tip="{Binding StoppedAt}" />
                </StackPanel>

                <Button Grid.Column="1" Classes="flat" FontWeight="Regular" BorderThickness="0"
                        Content="{DynamicResource Text.Repository.Skip}" Padding="8,2" Click="OnSkipInProgress"
                        IsVisible="{Binding StoppedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Grid>
            </DataTemplate>

            <DataTemplate DataType="vm:RevertInProgress">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Revert}"/>
                  <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Revert.Head}"/>
                  <TextBlock FontWeight="Bold"
                             Margin="4,0,0,0"
                             Foreground="DarkOrange"
                             FontFamily="{DynamicResource Fonts.Monospace}"
                             Text="{Binding Head.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                             ToolTip.Tip="{Binding Head}"/>
                </StackPanel>

                <Button Grid.Column="1" Classes="flat" FontWeight="Regular" BorderThickness="0" Content="{DynamicResource Text.Repository.Skip}" Padding="8,2" Click="OnSkipInProgress"/>
              </Grid>
            </DataTemplate>

            <DataTemplate DataType="vm:MergeInProgress">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Merge}"/>
                <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Merge.Operating}"/>
                <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="DarkOrange" Text="{Binding SourceName}" ToolTip.Tip="{Binding Source}"/>
                <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="→"/>
                <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="DarkOrange" Text="{Binding Current}"/>
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <Button Grid.Column="1"
                Classes="flat"
                FontWeight="Regular"
                BorderThickness="0"
                Content="{DynamicResource Text.Repository.Resolve}"
                Padding="8,2" Margin="0,0,8,0"
                Click="OnResolveInProgress"
                IsVisible="{Binding SelectedViewIndex, Converter={x:Static c:IntConverters.IsNotOne}}"/>

        <Button Grid.Column="2"
                Classes="flat"
                FontWeight="Regular"
                BorderThickness="0"
                Content="{DynamicResource Text.Repository.Abort}"
                Padding="8,2" Margin="0,0,8,0"
                Click="OnAbortInProgress"/>
      </Grid>

      <Grid Grid.Row="1"
            Height="28"
            ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
            Background="{DynamicResource Brush.Conflict}"
            IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:BisectState.None}}">
        <TextBlock Grid.Column="0"
                   FontWeight="Bold"
                   Margin="8,0"
                   Foreground="{DynamicResource Brush.Conflict.Foreground}"
                   Text="{DynamicResource Text.Bisect.WaitingForRange}"
                   IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:BisectState.WaitingForRange}}"/>

        <TextBlock Grid.Column="0"
                   FontWeight="Bold"
                   Margin="8,0"
                   Foreground="{DynamicResource Brush.Conflict.Foreground}"
                   Text="{DynamicResource Text.Bisect.Detecting}"
                   IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:BisectState.Detecting}}"/>

        <v:LoadingIcon Grid.Column="1"
                       Width="14" Height="14"
                       Margin="4,0"
                       IsVisible="{Binding IsBisectCommandRunning}"/>

        <Button Grid.Column="2"
                Classes="flat"
                Margin="4,0"
                FontWeight="Regular"
                BorderThickness="0"
                Content="{DynamicResource Text.Bisect.Good}"
                IsEnabled="{Binding !IsBisectCommandRunning}"
                Padding="8,2"
                Click="OnBisectCommand"
                Tag="good"/>
        <Button Grid.Column="3"
                Classes="flat"
                Margin="4,0"
                FontWeight="Regular"
                BorderThickness="0"
                Content="{DynamicResource Text.Bisect.Bad}"
                IsEnabled="{Binding !IsBisectCommandRunning}"
                Padding="8,2"
                Click="OnBisectCommand"
                Tag="bad"/>
        <Button Grid.Column="4"
                Classes="flat"
                Margin="4,0"
                FontWeight="Regular"
                BorderThickness="0"
                Content="{DynamicResource Text.Bisect.Skip}"
                IsEnabled="{Binding !IsBisectCommandRunning}"
                Padding="8,2"
                Click="OnBisectCommand"
                Tag="skip"/>
        <Button Grid.Column="5"
                Classes="flat"
                Margin="4,0"
                FontWeight="Regular"
                BorderThickness="0"
                Content="{DynamicResource Text.Bisect.Abort}"
                IsEnabled="{Binding !IsBisectCommandRunning}"
                Padding="8,2"
                Click="OnBisectCommand"
                Tag="reset"/>
      </Grid>

      <Border Grid.Row="2"
              Height="32"
              ClipToBounds="True"
              Background="{DynamicResource Brush.ToolBar}"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Brush.Border0}">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="SelectedViewIndex" Converter="{x:Static c:IntConverters.IsZero}"/>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="IncludedHistoryFilterCount" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
              <Binding Path="ExcludedHistoryFilterCount" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
              <Binding Path="CanFoldVisibleBranchesInGraph"/>
              <Binding Path="CanUnfoldBranchesInGraph"/>
              <Binding Path="HasInProgressStatus"/>
              <Binding Path="Submodules.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
            </MultiBinding>
          </MultiBinding>
        </Border.IsVisible>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,*">
          <Path Grid.Column="0"
                Margin="8,0,0,0"
                Width="12" Height="12"
                Data="{StaticResource Icons.Filter}"
                Fill="{DynamicResource Brush.FG2}"
                IsVisible="{Binding HistoryFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:FilterMode.Included}}"/>
          <Path Grid.Column="0"
                Margin="8,0,0,0"
                Width="12" Height="12"
                Data="{StaticResource Icons.EyeClose}"
                Fill="{DynamicResource Brush.FG2}"
                IsVisible="{Binding HistoryFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:FilterMode.Excluded}}"/>

          <ItemsControl Grid.Column="1"
                        Height="22"
                        Margin="8,4"
                        ClipToBounds="True"
                        VerticalAlignment="Top"
                        ItemsSource="{Binding UIStates.HistoryFilters}"
                        IsVisible="{Binding !IsHistoryFiltersCollapsed, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemHeight="22"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="m:HistoryFilter">
                <Border Height="20"
                        Margin="0,0,6,0"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{Binding Mode, Converter={x:Static c:FilterModeConverters.ToBorderBrush}}"
                        VerticalAlignment="Center">
                  <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto" MaxWidth="480"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="10" Height="10" Data="{StaticResource Icons.Branch}" IsVisible="{Binding IsBranch}"/>
                    <Path Grid.Column="0" Width="10" Height="10" Data="{StaticResource Icons.Tag}" IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:FilterType.Tag}}"/>
                    <Path Grid.Column="0" Width="10" Height="10" Data="{StaticResource Icons.Submodule}" IsVisible="{Binding IsPath}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Pattern, Converter={x:Static c:StringConverters.TrimRefsPrefix}}"
                               Margin="4,0,8,0"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="2" Classes="icon_button" VerticalAlignment="Center" Margin="0" Padding="0" Click="OnRemoveSelectedHistoryFilter">
                      <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Column="1"
                  Height="30"
                  Margin="6,0,0,0"
                  IsVisible="{Binding IsHistoryFiltersCollapsed, Mode=OneWay}">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}">
              <Run Text="{Binding UIStates.HistoryFilters.Count, Mode=OneWay}" FontWeight="Bold"/>
              <Run Text="{DynamicResource Text.Repository.FilterCommits.Summary}"/>
            </TextBlock>
          </Border>

          <ToggleButton Grid.Column="2"
                        Classes="filter_expander"
                        Width="20"
                        Margin="16,0,0,0"
                        Background="Transparent"
                        IsChecked="{Binding IsHistoryFiltersCollapsed, Mode=TwoWay}"/>

          <Button Grid.Column="3"
                  Width="20"
                  Margin="0,0,12,0"
                  Classes="icon_button"
                  Command="{Binding ClearHistoryFilters}"
                  ToolTip.Tip="{DynamicResource Text.Repository.ClearAllCommitsFilter}">
            <Path Width="14" Height="14" Margin="0,1,0,0" Data="{StaticResource Icons.RemoveAll}"/>
          </Button>

          <TextBox Grid.Column="4"
                   x:Name="TxtHistoryQuickFindBox"
                   Width="150"
                   Height="24"
                   Margin="8,2,0,2"
                   VerticalContentAlignment="Center"
                   Watermark="Quick find in history"
                   Text="{Binding HistoryQuickFindText, Mode=TwoWay}"
                   Tag="{Binding HistoryQuickFindFocusRequestId}"
                   PropertyChanged="OnHistoryQuickFindBoxPropertyChanged"
                   KeyDown="OnHistoryQuickFindKeyDown"
                   IsVisible="{Binding SelectedViewIndex, Converter={x:Static c:IntConverters.IsZero}}">
            <TextBox.InnerLeftContent>
              <Path Width="12"
                    Height="12"
                    Margin="6,0,0,0"
                    Fill="{DynamicResource Brush.FG2}"
                    Data="{StaticResource Icons.Search}"/>
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <TextBlock Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         FontSize="10"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{OnPlatform Ctrl+F, macOS=⌘+F}"/>
            </TextBox.InnerRightContent>
          </TextBox>

          <Border Grid.Column="5"
                  Margin="8,0,0,0"
                  Padding="1"
                  CornerRadius="9"
                  Background="{DynamicResource Brush.BG1}"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  BorderThickness="1"
                  ToolTip.Tip="Show or hide tag refs in the history graph">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <RadioButton Classes="history_order_segment"
                           GroupName="HistoryTagsInline"
                           IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=ShowTagsInGraph}"
                           Click="OnHistoryTagsShownClicked">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Width="10"
                        Height="10"
                        Data="{StaticResource Icons.Tag}"/>
                  <TextBlock Text="Tags"/>
                </StackPanel>
              </RadioButton>

              <RadioButton Classes="history_order_segment"
                           GroupName="HistoryTagsInline"
                           IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=ShowTagsInGraph, Converter={x:Static BoolConverters.Not}}"
                           Click="OnHistoryTagsHiddenClicked">
                <TextBlock Text="No Tags"/>
              </RadioButton>
            </StackPanel>
          </Border>

          <Button Grid.Column="6"
                  Classes="flat"
                  Margin="8,0,0,0"
                  Padding="8,2"
                  Click="OnOpenSubmoduleHistoryFilter"
                  ToolTip.Tip="{DynamicResource Text.Repository.SubmoduleUpdateFilter.ToolTip}"
                  IsVisible="{Binding Submodules.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Width="12" Height="12"
                    Fill="{DynamicResource Brush.FG2}"
                    Data="{StaticResource Icons.Submodule}"/>
              <TextBlock Text="{DynamicResource Text.Repository.SubmoduleUpdateFilter.Short}"/>
              <TextBlock Foreground="{DynamicResource Brush.Accent}"
                         FontWeight="SemiBold"
                         Text="{Binding HistoryPathFilterCount, StringFormat='({0})'}"
                         IsVisible="{Binding HistoryPathFilterCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"/>
              <Path Width="10" Height="10"
                    Fill="{DynamicResource Brush.FG2}"
                    Data="{StaticResource Icons.Down}"/>
            </StackPanel>
          </Button>

          <StackPanel Grid.Column="7"
                      Margin="8,0,8,0"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="6"
                      VerticalAlignment="Center">
            <Button Classes="flat"
                    Padding="8,2"
                    Click="OnFoldVisibleBranchesInGraph"
                    IsEnabled="{Binding CanFoldVisibleBranchesInGraph}"
                    ToolTip.Tip="Fold all visible branches in graph">
              <StackPanel Orientation="Horizontal">
                <Path Width="12" Height="12" Margin="0,0,6,0" Data="{StaticResource Icons.Minus}" Fill="{DynamicResource Brush.FG2}"/>
                <TextBlock Text="Fold Visible"/>
              </StackPanel>
            </Button>

            <Button Classes="flat"
                    Padding="8,2"
                    Click="OnUnfoldAllBranchesInGraph"
                    IsEnabled="{Binding CanUnfoldBranchesInGraph}"
                    ToolTip.Tip="Unfold all folded branches in graph">
              <StackPanel Orientation="Horizontal">
                <Path Width="12" Height="12" Margin="0,0,6,0" Data="{StaticResource Icons.Plus}" Fill="{DynamicResource Brush.FG2}"/>
                <TextBlock Text="Unfold All"/>
              </StackPanel>
            </Button>

            <Button Classes="icon_button"
                    Command="{Binding ClearHistoryFilters}"
                    ToolTip.Tip="{DynamicResource Text.Repository.ClearAllCommitsFilter}">
              <Path Width="14" Height="14" Margin="8,0,8,0" Data="{StaticResource Icons.RemoveAll}"/>
            </Button>

            <Border Margin="2,0,0,0"
                    Padding="1"
                    CornerRadius="9"
                    Background="{DynamicResource Brush.BG1}"
                    BorderBrush="{DynamicResource Brush.Border1}"
                    BorderThickness="1"
                    IsVisible="{Binding SelectedViewIndex, Converter={x:Static c:IntConverters.IsZero}}">
              <StackPanel Orientation="Horizontal" Spacing="1">
                <RadioButton Classes="history_order_segment"
                             GroupName="HistoryOrderModeInline"
                             IsChecked="{Binding EnableTopoOrderInHistory, Converter={x:Static BoolConverters.Not}}"
                             Click="OnHistoryOrderByDateClicked">
                  <ToolTip.Tip>
                    <StackPanel Orientation="Vertical" MaxWidth="320">
                      <TextBlock FontWeight="Bold" Text="{DynamicResource Text.Repository.HistoriesOrder.ByDate}"/>
                      <TextBlock Classes="small"
                                 Margin="0,4,0,0"
                                 Foreground="{DynamicResource Brush.FG2}"
                                 Text="Order commits by commit date."/>
                    </StackPanel>
                  </ToolTip.Tip>
                  <TextBlock Text="Date"/>
                </RadioButton>

                <RadioButton Classes="history_order_segment"
                             GroupName="HistoryOrderModeInline"
                             IsChecked="{Binding EnableTopoOrderInHistory}"
                             Click="OnHistoryOrderTopoClicked">
                  <ToolTip.Tip>
                    <StackPanel Orientation="Vertical" MaxWidth="320">
                      <TextBlock FontWeight="Bold" Text="{DynamicResource Text.Repository.HistoriesOrder.Topo}"/>
                      <TextBlock Classes="small"
                                 Margin="0,4,0,0"
                                 Foreground="{DynamicResource Brush.FG2}"
                                 Text="Order commits by graph topology."/>
                    </StackPanel>
                  </ToolTip.Tip>
                  <TextBlock Text="Topo"/>
                </RadioButton>
              </StackPanel>
            </Border>

            <Border Padding="8,2"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#FF8E44AD"
                    Background="#1A8E44AD"
                    IsVisible="{Binding HasInProgressStatus}">
              <TextBlock Foreground="#FF7C3AED"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Text="{Binding InProgressStatusText}"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="3">
        <ContentControl Content="{Binding Histories, Mode=OneWay}" IsVisible="{Binding IsHistoriesVisible, Mode=OneWay}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:Histories">
              <v:Histories CurrentBranch="{Binding CurrentBranch, Mode=OneWay}"
                           Bisect="{Binding Bisect, Mode=OneWay}"
                           IssueTrackers="{Binding IssueTrackers, Mode=OneWay}"
                           OnlyHighlightCurrentBranch="{Binding HighlightCurrentBranchOnly, Mode=OneWay}"
                           NavigationId="{Binding NavigationId, Mode=OneWay}"/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <ContentControl Content="{Binding WorkingCopy, Mode=OneWay}" IsVisible="{Binding IsWorkingCopyVisible, Mode=OneWay}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:WorkingCopy">
              <v:WorkingCopy/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <ContentControl Content="{Binding StashesPage, Mode=OneWay}" IsVisible="{Binding IsStashesVisible, Mode=OneWay}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:StashesPage">
              <v:StashesPage/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <ContentControl Content="{Binding SubmoduleCommitFlow, Mode=OneWay}" IsVisible="{Binding IsSubmoduleCommitFlowVisible, Mode=OneWay}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:SubmoduleCommitFlow">
              <v:SubmoduleCommitFlow/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>
    </Grid>

    <!-- Right (Background Operation) -->
    <Border Grid.Column="2" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="drop-shadow(0 0 12 #A0000000)">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="IsAutoFetching"/>
          <Binding Path="IsQuickFetching"/>
          <Binding Path="IsQuickPulling"/>
        </MultiBinding>
      </Border.IsVisible>
      <Border Background="{DynamicResource Brush.Popup}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}">
        <StackPanel Orientation="Vertical" Margin="16,8">
          <TextBlock Text="{Binding AutoBackgroundOperationText}"/>
          <ProgressBar Margin="0,8,0,0"
                       HorizontalAlignment="Stretch"
                       IsIndeterminate="True"
                       Background="{DynamicResource Brush.FG2}" Foreground="{DynamicResource Brush.Accent}"
                       Minimum="0" Maximum="100"/>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.Column="2"
            Margin="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Effect="drop-shadow(0 0 12 #A0000000)"
            IsVisible="{Binding IsFetchDurationToastVisible}"
            Opacity="{Binding FetchDurationToastOpacity}">
      <Border Background="#FF1F2937" CornerRadius="6">
        <StackPanel Orientation="Horizontal" Margin="16,10">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Info}" Fill="#FFFFD54F"/>
          <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Foreground="White" Text="{Binding FetchDurationToastText}"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
