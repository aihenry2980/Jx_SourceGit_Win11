<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:c="using:SourceGit.Converters"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                    x:Class="SourceGit.Views.ViewLogs"
                    x:DataType="vm:ViewLogs"
                    x:Name="ThisControl"
                    Title="{DynamicResource Text.ViewLogs}"
                    Icon="/App.ico"
                    Width="800" Height="500"
                    MinWidth="620" MinHeight="320"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid x:Name="Root" RowDefinitions="Auto,*,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Logs}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.ViewLogs}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1" Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MaxWidth="500" MinWidth="250"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0"
               Padding="4"
               Background="{DynamicResource Brush.Contents}"
               BorderThickness="1"
               BorderBrush="{DynamicResource Brush.Border2}"
               ItemsSource="{Binding Logs}"
               SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
               SelectionMode="Single"
               KeyDown="OnLogKeyDown"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="4"/>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:CommandLog">
            <Grid Background="Transparent" RowDefinitions="Auto,Auto" ContextRequested="OnLogContextRequested">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="72"/>
              </Grid.ColumnDefinitions>

              <v:LoadingIcon Grid.Column="0"
                             Width="14" Height="14"
                             Margin="4,0,4,0"
                             IsVisible="{Binding !IsComplete}"/>

              <TextBlock Grid.Column="1"
                         Margin="4,3,0,0"
                         Text="{Binding Name}"
                         ToolTip.Tip="{Binding Name}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>

              <TextBlock Grid.Column="2"
                         Margin="4,3"
                         FontSize="11"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding StatusText}"
                         ToolTip.Tip="{Binding StatusText}"
                         Classes.failed="{Binding IsFailed}">
                <TextBlock.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
                  </Style>
                  <Style Selector="TextBlock.failed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                  </Style>
                </TextBlock.Styles>
              </TextBlock>

              <v:CommandLogTime Grid.Column="3"
                                Margin="4,3"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.FG2}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>

              <Grid Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="4,0,4,3"
                    ColumnDefinitions="*,*">
                <ToolTip.Tip>
                  <StackPanel MaxWidth="720">
                    <TextBlock Text="{Binding RepositoryPath}" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource Brush.FG2}" Text="{Binding LatestCommand}" TextWrapping="Wrap"/>
                  </StackPanel>
                </ToolTip.Tip>
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.FG2}"
                           Text="{Binding RepositoryName}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Margin="6,0,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.FG2}"
                           Text="{Binding LatestCommand}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Path Grid.Column="0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="48" Height="48"
            Data="{StaticResource Icons.Empty}"
            Fill="{DynamicResource Brush.FG2}"
            IsVisible="{Binding Logs.Count, Converter={x:Static c:IntConverters.IsZero}}"/>

      <GridSplitter Grid.Column="1"
                    MinWidth="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"/>

      <Border Grid.Column="2"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1"
              Background="{DynamicResource Brush.Contents}">
        <Grid RowDefinitions="*,Auto">
          <v:CommandLogContentPresenter x:Name="LogContent" Log="{Binding SelectedLog}"/>
          <Button Grid.Row="1" Classes="flat" HorizontalAlignment="Right" Margin="4"
                  IsVisible="{Binding !#LogContent.IsFollowingOutput}" Click="OnFollowOutput">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Width="12" Height="12" Data="{StaticResource Icons.Down}"/>
              <TextBlock Text="{DynamicResource Text.ViewLogs.FollowOutput}"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Margin="8,0,8,8" Spacing="6">
      <TextBlock x:Name="AutoCloseCountdown"
                 HorizontalAlignment="Right"
                 TextWrapping="Wrap"
                 FontWeight="Bold"
                 Foreground="#FF2E7D32"
                 IsVisible="False"/>
      <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Classes="flat" Margin="4,2"
                Content="{DynamicResource Text.ViewLogs.CopyCommand}"
                Click="OnCopyCurrentCommand"
                IsEnabled="{Binding SelectedLog.LatestCommand, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>

        <Button x:Name="ClearCompletedButton" Classes="flat"
                Margin="4,2"
                Content="{DynamicResource Text.ViewLogs.ClearCompleted}"
                Command="{Binding ClearAll}"
                IsEnabled="{Binding Logs.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"/>

        <Button x:Name="CancelTaskButton"
                Classes="flat"
                Classes.primary="{Binding SelectedLog.CanCancel}"
                Margin="4,2"
                Content="{DynamicResource Text.ViewLogs.CancelTask}"
                Click="OnCancelSelectedTask"
                IsEnabled="{Binding SelectedLog.CanCancel}"
                ToolTip.Tip="{DynamicResource Text.ViewLogs.CancelTask}"/>
        <Button Classes="flat" Margin="4,2"
                Content="{DynamicResource Text.Close}"
                Click="OnClose"/>
      </WrapPanel>
    </StackPanel>
  </Grid>
</v:ChromelessWindow>
