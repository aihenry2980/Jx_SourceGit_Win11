<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="SourceGit.Views.SubmoduleCommitFlow"
             x:DataType="vm:SubmoduleCommitFlow">
  <Grid>
    <Grid x:Name="LayoutRootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" MinWidth="240"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,4,*">
      <Border Grid.Row="0"
              Height="42"
              Padding="12,0"
              Background="{DynamicResource Brush.ToolBar}"
              BorderBrush="{DynamicResource Brush.Border0}"
              BorderThickness="0,0,1,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0"
                Width="16"
                Height="16"
                Data="{StaticResource Icons.Submodules}"
                Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Text="Submodule Commit Flow"/>
          <Button Grid.Column="2"
                  Classes="icon_button"
                  Width="28"
                  Height="28"
                  Click="OnRefreshClicked"
                  ToolTip.Tip="Refresh submodule commit flow">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Refresh}"/>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Padding="12,8"
              BorderBrush="{DynamicResource Brush.Border0}"
              BorderThickness="0,0,1,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding Summary}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.FG2}"/>
          <v:LoadingIcon Grid.Column="1"
                         Width="16"
                         Height="16"
                         Margin="8,0,0,0"
                         IsVisible="{Binding IsLoading}"/>
        </Grid>
      </Border>

      <Border Grid.Row="2"
              Margin="8,6"
              Padding="8,6"
              CornerRadius="6"
              BorderBrush="{DynamicResource Brush.Border0}"
              BorderThickness="1"
              Background="{DynamicResource Brush.Contents}"
              IsVisible="{Binding HasParentChain}">
        <StackPanel Orientation="Vertical" Spacing="5">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG1}"
                       Text="Parent chain"/>
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding ParentChainSummary}"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>

          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ParentChainSteps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SubmoduleCommitFlowChainStep">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{Binding BorderBrush}"
                               Text="{Binding CurrentMarker}"/>
                    <Border Height="21"
                            MinWidth="42"
                            MaxWidth="96"
                            Margin="0,0,3,0"
                            Padding="7,1"
                            CornerRadius="10"
                            BorderThickness="1.5"
                            BorderBrush="{Binding BorderBrush}"
                            Background="{Binding Background}">
                      <ToolTip.Tip>
                        <StackPanel>
                          <TextBlock Text="{Binding FullPath}"/>
                          <TextBlock Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Status}"/>
                        </StackPanel>
                      </ToolTip.Tip>
                      <TextBlock FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding Foreground}"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"/>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <ListBox x:Name="ModuleList"
               Grid.Row="3"
               MaxHeight="420"
               Background="{DynamicResource Brush.Contents}"
               BorderThickness="0,0,1,0"
               BorderBrush="{DynamicResource Brush.Border0}"
               ItemsSource="{Binding Nodes}"
               SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
               SelectionMode="AlwaysSelected"
               KeyDown="OnModuleListKeyDown">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:SubmoduleCommitFlowNode">
            <Grid Margin="0"
                  ColumnDefinitions="16,Auto,*"
                  MinHeight="46"
                  DoubleTapped="OnNodeDoubleTapped"
                  ContextRequested="OnNodeContextRequested">
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         FontSize="13"
                         FontWeight="Bold"
                         Foreground="{Binding BorderBrush}"
                         Text="{Binding SelectionArrow}"/>

              <ItemsControl Grid.Column="1"
                            Width="{Binding Indent}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding HierarchyDots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:SubmoduleCommitFlowHierarchyDot">
                    <Ellipse Width="7"
                             Height="7"
                             Margin="5.5,0"
                             Fill="#E85D5B"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Grid.Column="2"
                      Margin="2,4,6,4"
                      Padding="7,4"
                      CornerRadius="6"
                      BorderThickness="{Binding SelectionBorderThickness}"
                      BorderBrush="{Binding SelectionBorderBrush}">
                <Border Padding="8,5"
                        CornerRadius="5"
                        BorderThickness="2,0,0,0"
                        BorderBrush="{Binding BorderBrush}"
                      Background="{Binding StatusBackground}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Row="0"
                             Grid.Column="0"
                             FontWeight="SemiBold"
                             Text="{Binding DisplayName}"
                             TextTrimming="CharacterEllipsis"/>
                  <Border Grid.Row="0"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          Padding="10,2"
                          CornerRadius="10"
                          Background="{Binding StatusBackground}"
                          BorderBrush="{Binding StatusForeground}"
                          BorderThickness="1.25">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{Binding StatusForeground}"/>
                  </Border>

                  <StackPanel Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0,4,0,0"
                              Orientation="Horizontal"
                              Spacing="8">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource Brush.FG2}"
                               Text="{Binding Branch}"/>
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource Brush.FG2}"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               Text="{Binding HeadShort}"/>
                  </StackPanel>
                </Grid>
                </Border>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Row="4"
                    MinHeight="1"
                    Background="{DynamicResource Brush.Border0}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"/>

      <Grid Grid.Row="5" RowDefinitions="Auto,Auto,*" Background="{DynamicResource Brush.Contents}">
        <Border Grid.Row="0"
                Padding="10,7"
                BorderBrush="{DynamicResource Brush.Border0}"
                BorderThickness="0,1,1,1">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0"
                  Width="14"
                  Height="14"
                  Data="{StaticResource Icons.Commit}"
                  Fill="{DynamicResource Brush.FG2}"/>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock FontWeight="Bold"
                         Text="{Binding SelectedNodeTitle}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock FontSize="11"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{Binding SelectedNode.RepoPath}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="2"
                    Classes="icon_button"
                    Width="28"
                    Height="28"
                    Click="OnOpenTerminalClicked"
                    IsEnabled="{Binding HasSelectedNode}"
                    ToolTip.Tip="Open Terminal">
              <Path Width="14" Height="14" Data="{StaticResource Icons.Terminal}"/>
            </Button>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource Brush.Border0}"
                BorderThickness="0,0,1,1">
          <WrapPanel Margin="8,2,4,2"
                     Orientation="Horizontal"
                     HorizontalAlignment="Stretch">
            <TextBlock VerticalAlignment="Center"
                       Margin="0,2,8,2"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}">
              <Run Text="Changes "/>
              <Run Text="{Binding Changes, Converter={x:Static c:ListConverters.ToCount}}"/>
            </TextBlock>

            <TextBlock VerticalAlignment="Center"
                       Margin="0,2,8,2"
                       MaxWidth="128"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding CommitIncludeSummary}"
                       TextTrimming="CharacterEllipsis"/>

            <CheckBox VerticalAlignment="Center"
                      Margin="0,2,8,2"
                      Content="Untracked"
                      IsChecked="{Binding IncludeUntrackedChanges, Mode=TwoWay}"
                      ToolTip.Tip="Include untracked files in Commit Flow scan"/>

            <v:ChangeViewModeSwitcher Width="28"
                                      Height="24"
                                      Margin="0,2,4,2"
                                      ViewMode="{Binding ChangeViewMode, Mode=TwoWay}"/>

            <Button Classes="flat"
                    Height="24"
                    Margin="0,2,4,2"
                    Padding="8,0"
                    Content="Skip all"
                    Click="OnExcludeAllChangesClicked"
                    IsEnabled="{Binding HasChanges}"/>

            <Button Classes="flat"
                    Height="24"
                    Margin="0,2,4,2"
                    Padding="8,0"
                    Content="Include all"
                    Click="OnIncludeAllChangesClicked"
                    IsEnabled="{Binding HasChanges}"/>
          </WrapPanel>
        </Border>

        <v:ChangeCollectionView x:Name="ChangesList"
                                Grid.Row="2"
                                IsUnstagedChange="True"
                                Background="{DynamicResource Brush.Contents}"
                                ViewMode="{Binding ChangeViewMode, Mode=TwoWay}"
                                ShowCommitIncludeCheckBoxes="True"
                                CommitIncludeToggled="OnCommitIncludeToggled"
                                ContextRequested="OnChangesContextRequested"
                                EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                Changes="{Binding Changes}"
                                SelectedChanges="{Binding SelectedChanges, Mode=TwoWay}"/>
      </Grid>
      </Grid>

      <GridSplitter Grid.Column="1"
                    MinWidth="1"
                    Background="{DynamicResource Brush.Border0}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"/>

      <Grid Grid.Column="2" RowDefinitions="*,4,136,Auto,40" Margin="8,6,8,8">
        <Grid Grid.Row="0">
          <Border BorderBrush="{DynamicResource Brush.Border2}"
                  BorderThickness="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <Path Width="56"
                    Height="56"
                    Data="{StaticResource Icons.Diff}"
                    Fill="{DynamicResource Brush.FG2}"/>
              <TextBlock Margin="0,12,0,0"
                         HorizontalAlignment="Center"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="Select a change to preview"/>
            </StackPanel>
          </Border>
          <ContentControl Content="{Binding DetailContext}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:DiffContext">
                <v:DiffView/>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>

          <Border HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,2,0,0"
                  Padding="5,4"
                  CornerRadius="4"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  Background="{DynamicResource Brush.Contents}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Width="112"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{Binding SelectedChangeEncoding}"
                         ToolTip.Tip="Detected encoding of the selected file"/>

              <ComboBox Width="104"
                        Height="30"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding SaveEncodingOptions}"
                        SelectedItem="{Binding SelectedSaveEncoding, Mode=TwoWay}"
                        ToolTip.Tip="Encoding used when saving the selected file(s)"/>

              <Button Classes="flat"
                      Height="30"
                      Padding="8,0"
                      VerticalContentAlignment="Center"
                      Content="Save"
                      Click="OnSaveSelectedChangesEncodingClicked"
                      IsEnabled="{Binding CanSaveSelectedChangesWithEncoding}"
                      ToolTip.Tip="{Binding SaveSelectedChangesEncodingToolTip}"/>
            </StackPanel>
          </Border>
        </Grid>

      <GridSplitter Grid.Row="1"
                    MinHeight="1"
                    Background="{DynamicResource Brush.Border0}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"/>

      <v:CommitMessageToolBox Grid.Row="2"
                              Margin="0,8,0,0"
                              ShowAdvancedOptions="False"
                              CommitMessage="{Binding CommitMessage, Mode=TwoWay}"/>

      <Border Grid.Row="3"
              Margin="0,6,0,0"
              Padding="8,5"
              BorderBrush="{DynamicResource Brush.Border0}"
              BorderThickness="1"
              CornerRadius="4"
              Background="{DynamicResource Brush.Contents}">
        <ScrollViewer MaxHeight="54"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock Text="{Binding CommitPlanPreview}"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.FG2}"
                               TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG2}"
                   TextTrimming="CharacterEllipsis"
                   Text="Commit stages the listed changes; generated untracked files matching preferences are skipped."/>
        <Border Grid.Column="1"
                Margin="0,0,8,0"
                Background="Transparent"
                ToolTip.Tip="{Binding UndoCommitToolTip}">
          <Button Classes="flat"
                  Height="28"
                  MinWidth="112"
                  Padding="10,0"
                  Click="OnUndoCommitClicked"
                  IsEnabled="{Binding CanUndoSelectedNodeCommit}"
                  IsHitTestVisible="{Binding CanUndoSelectedNodeCommit}">
            <TextBlock Text="Undo Commit" TextWrapping="NoWrap"/>
          </Button>
        </Border>
        <Border Grid.Column="2"
                Margin="0,0,8,0"
                Background="Transparent"
                ToolTip.Tip="{Binding CommitAndPushButtonToolTip}">
          <Button Classes="flat"
                  Height="28"
                  MinWidth="180"
                  Padding="12,0"
                  Background="{Binding CommitAndPushButtonBackground}"
                  Foreground="{Binding CommitAndPushButtonForeground}"
                  Click="OnCommitAndPushClicked"
                  IsEnabled="{Binding CanCommitAndPushSelectedNode}"
                  IsHitTestVisible="{Binding CanCommitAndPushSelectedNode}">
            <TextBlock Text="{Binding CommitAndPushButtonText}" TextWrapping="NoWrap"/>
          </Button>
        </Border>
        <v:LoadingIcon Grid.Column="3"
                       Width="18"
                       Height="18"
                       Margin="0,0,8,0"
                       IsVisible="{Binding IsCommitting}"/>
        <Border Grid.Column="4"
                Background="Transparent"
                ToolTip.Tip="{Binding CommitButtonToolTip}">
          <Button Classes="flat primary"
                  Height="28"
                  MinWidth="220"
                  Padding="12,0"
                  Click="OnCommitClicked"
                  IsEnabled="{Binding CanCommitSelectedNode}"
                  IsHitTestVisible="{Binding CanCommitSelectedNode}">
            <TextBlock Text="{Binding CommitButtonText}" TextWrapping="NoWrap"/>
          </Button>
        </Border>
      </Grid>
      </Grid>
    </Grid>

    <Border HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,58"
            Padding="14,9"
            MinWidth="260"
            MaxWidth="620"
            CornerRadius="8"
            Background="{Binding ToastBackground}"
            Opacity="{Binding ToastOpacity}"
            IsVisible="{Binding IsToastVisible}"
            BoxShadow="0 6 20 0 #66000000">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
        </Transitions>
      </Border.Transitions>
      <TextBlock HorizontalAlignment="Center"
                 Text="{Binding ToastMessage}"
                 TextWrapping="Wrap"
                 Foreground="White"
                 FontWeight="SemiBold"/>
    </Border>
  </Grid>
</UserControl>
