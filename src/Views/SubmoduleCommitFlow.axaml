<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="SourceGit.Views.SubmoduleCommitFlow"
             x:DataType="vm:SubmoduleCommitFlow">
  <Grid>
    <Grid ColumnDefinitions="360,4,*">
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
      <Border Grid.Row="0"
              Height="42"
              Padding="12,0"
              Background="{DynamicResource Brush.ToolBar}"
              BorderBrush="{DynamicResource Brush.Border0}"
              BorderThickness="0,0,1,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0"
                Width="16"
                Height="16"
                Data="{StaticResource Icons.Submodules}"
                Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Text="Submodule Commit Flow"/>
          <Button Grid.Column="2"
                  Classes="icon_button"
                  Width="28"
                  Height="28"
                  Click="OnRefreshClicked"
                  ToolTip.Tip="Refresh submodule commit flow">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Refresh}"/>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Padding="12,8"
              BorderBrush="{DynamicResource Brush.Border0}"
              BorderThickness="0,0,1,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding Summary}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.FG2}"/>
          <v:LoadingIcon Grid.Column="1"
                         Width="16"
                         Height="16"
                         Margin="8,0,0,0"
                         IsVisible="{Binding IsLoading}"/>
        </Grid>
      </Border>

      <ListBox Grid.Row="2"
               Background="{DynamicResource Brush.Contents}"
               BorderThickness="0,0,1,0"
               BorderBrush="{DynamicResource Brush.Border0}"
               ItemsSource="{Binding Nodes}"
               SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
               SelectionMode="AlwaysSelected">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:SubmoduleCommitFlowNode">
            <Grid Margin="0" ColumnDefinitions="Auto,*" MinHeight="46">
              <Border Grid.Column="0"
                      Width="{Binding Indent}"
                      Background="Transparent"/>
              <Border Grid.Column="1"
                      Margin="6,4"
                      Padding="8,5"
                      CornerRadius="6"
                      BorderThickness="2,0,0,0"
                      BorderBrush="{Binding BorderBrush}"
                      Background="{Binding StatusBackground}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Row="0"
                             Grid.Column="0"
                             FontWeight="SemiBold"
                             Text="{Binding DisplayPath}"
                             TextTrimming="CharacterEllipsis"/>
                  <Border Grid.Row="0"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          Padding="8,1"
                          CornerRadius="8"
                          Background="{Binding StatusBackground}"
                          BorderBrush="{Binding StatusForeground}"
                          BorderThickness="1">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{Binding StatusForeground}"/>
                  </Border>

                  <StackPanel Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0,4,0,0"
                              Orientation="Horizontal"
                              Spacing="8">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource Brush.FG2}"
                               Text="{Binding Branch}"/>
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource Brush.FG2}"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               Text="{Binding HeadShort}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </Grid>

      <GridSplitter Grid.Column="1"
                    MinWidth="1"
                    Background="{DynamicResource Brush.Border0}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"/>

      <Grid Grid.Column="2" RowDefinitions="Auto,*,4,136,40" Margin="8,6,8,8">
      <Border Grid.Row="0"
              Padding="10,7"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0"
                Width="14"
                Height="14"
                Data="{StaticResource Icons.Commit}"
                Fill="{DynamicResource Brush.FG2}"/>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding SelectedNodeTitle}"/>
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding SelectedNode.RepoPath}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="2"
                  Classes="flat"
                  Padding="10,2"
                  Content="Open Terminal"
                  Click="OnOpenTerminalClicked"
                  IsEnabled="{Binding HasSelectedNode}"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="360,4,*" Margin="0,8,0,0">
        <Grid Grid.Column="0" RowDefinitions="28,*">
          <Border Grid.Row="0"
                  BorderBrush="{DynamicResource Brush.Border0}"
                  BorderThickness="0,0,0,1">
            <TextBlock Margin="8,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}">
              <Run Text="Changes "/>
              <Run Text="{Binding Changes, Converter={x:Static c:ListConverters.ToCount}}"/>
            </TextBlock>
          </Border>

          <v:ChangeCollectionView Grid.Row="1"
                                  IsUnstagedChange="True"
                                  Background="{DynamicResource Brush.Contents}"
                                  ViewMode="List"
                                  EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                  Changes="{Binding Changes}"
                                  SelectedChanges="{Binding SelectedChanges, Mode=TwoWay}"/>
        </Grid>

        <GridSplitter Grid.Column="1"
                      MinWidth="1"
                      Background="{DynamicResource Brush.Border0}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Focusable="False"/>

        <Grid Grid.Column="2">
          <Border BorderBrush="{DynamicResource Brush.Border2}"
                  BorderThickness="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <Path Width="56"
                    Height="56"
                    Data="{StaticResource Icons.Diff}"
                    Fill="{DynamicResource Brush.FG2}"/>
              <TextBlock Margin="0,12,0,0"
                         HorizontalAlignment="Center"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="Select a change to preview"/>
            </StackPanel>
          </Border>
          <ContentControl Content="{Binding DetailContext}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:DiffContext">
                <v:DiffView/>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Grid>
      </Grid>

      <GridSplitter Grid.Row="2"
                    MinHeight="1"
                    Background="{DynamicResource Brush.Border0}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"/>

      <v:CommitMessageToolBox Grid.Row="3"
                              Margin="0,8,0,0"
                              ShowAdvancedOptions="False"
                              CommitMessage="{Binding CommitMessage, Mode=TwoWay}"/>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="Commit uses git add -A for the selected repository."/>
        <Button Grid.Column="1"
                Classes="flat"
                Height="28"
                Margin="0,0,8,0"
                Padding="10,0"
                Content="Undo Commit"
                ToolTip.Tip="Reset the selected repository back to the commit before this Commit Flow commit, leaving the files modified but uncommitted."
                Click="OnUndoCommitClicked"
                IsEnabled="{Binding CanUndoSelectedNodeCommit}"/>
        <Button Grid.Column="2"
                Classes="flat"
                Height="28"
                Margin="0,0,8,0"
                Padding="12,0"
                Background="{Binding CommitAndPushButtonBackground}"
                Foreground="{Binding CommitAndPushButtonForeground}"
                Content="Commit &amp; Push"
                ToolTip.Tip="{Binding SelectedNode.PushTargetDescription}"
                Click="OnCommitAndPushClicked"
                IsEnabled="{Binding CanCommitAndPushSelectedNode}"/>
        <v:LoadingIcon Grid.Column="3"
                       Width="18"
                       Height="18"
                       Margin="0,0,8,0"
                       IsVisible="{Binding IsCommitting}"/>
        <Button Grid.Column="4"
                Classes="flat primary"
                Height="28"
                Padding="12,0"
                Content="Stage All &amp; Commit"
                Click="OnCommitClicked"
                IsEnabled="{Binding CanCommitSelectedNode}"/>
      </Grid>
      </Grid>
    </Grid>

    <Border HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,58"
            Padding="14,9"
            MinWidth="260"
            MaxWidth="620"
            CornerRadius="8"
            Background="{Binding ToastBackground}"
            Opacity="{Binding ToastOpacity}"
            IsVisible="{Binding IsToastVisible}"
            BoxShadow="0 6 20 0 #66000000">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
        </Transitions>
      </Border.Transitions>
      <TextBlock HorizontalAlignment="Center"
                 Text="{Binding ToastMessage}"
                 TextWrapping="Wrap"
                 Foreground="White"
                 FontWeight="SemiBold"/>
    </Border>
  </Grid>
</UserControl>
