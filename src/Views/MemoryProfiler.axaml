<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:m="using:SourceGit.Models"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
                    x:Class="SourceGit.Views.MemoryProfiler"
                    x:DataType="vm:MemoryProfiler"
                    x:Name="ThisControl"
                    Title="Memory Profile"
                    Icon="/App.ico"
                    Width="980" Height="640"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Statistics}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="Memory Profile"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <Border Grid.Row="1"
            Margin="8,8,8,0"
            Padding="10"
            Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border2}"
            BorderThickness="1"
            CornerRadius="6">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,*,*,*">
          <Border Grid.Column="0" Margin="0,0,8,0" Padding="8" Background="{DynamicResource Brush.BG1}" CornerRadius="4">
            <StackPanel Spacing="2">
              <TextBlock Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="Process private"/>
              <TextBlock Classes="bold" Text="{Binding ProcessPrivateMemory}"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Margin="0,0,8,0" Padding="8" Background="{DynamicResource Brush.BG1}" CornerRadius="4">
            <StackPanel Spacing="2">
              <TextBlock Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="Managed heap"/>
              <TextBlock Classes="bold" Text="{Binding ManagedHeapMemory}"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Margin="0,0,8,0" Padding="8" Background="{DynamicResource Brush.BG1}" CornerRadius="4">
            <StackPanel Spacing="2">
              <TextBlock Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="Tracked repos"/>
              <TextBlock Classes="bold" Text="{Binding TrackedRepositoryMemory}"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="3" Padding="8" Background="{DynamicResource Brush.BG1}" CornerRadius="4">
            <StackPanel Spacing="2">
              <TextBlock Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="Shared caches"/>
              <TextBlock Classes="bold" Text="{Binding TrackedSharedMemory}"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="Snapshot:"/>
          <TextBlock Grid.Column="1" Margin="6,0,0,0" Classes="small" Foreground="{DynamicResource Brush.FG2}" Text="{Binding SnapshotTime}"/>
        </Grid>

        <TextBlock Classes="small"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{Binding EstimateNote}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Margin="10,10,10,6"
                     Classes="bold"
                     Text="Open Repositories"/>

          <ListBox Grid.Row="1"
                   Margin="8,0,8,8"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding Repositories}"
                   SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                   SelectionMode="Single"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="0"/>
              </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
              <DataTemplate DataType="m:RepositoryMemoryProfile">
                <Border Padding="8"
                        Background="{DynamicResource Brush.BG1}"
                        BorderBrush="{DynamicResource Brush.Border1}"
                        BorderThickness="1"
                        CornerRadius="4">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0"
                                 Classes="bold"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Text="{Binding EstimatedBytesText}"/>
                    </Grid>

                    <TextBlock Classes="small"
                               Foreground="{DynamicResource Brush.FG2}"
                               Text="{Binding TopSuspectDetail}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Classes="small"
                               Foreground="{DynamicResource Brush.FG2}"
                               Text="{Binding CountsSummary}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    MinWidth="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"/>

      <Border Grid.Column="2"
              Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1"
              CornerRadius="6">
        <ScrollViewer>
          <StackPanel Margin="10" Spacing="12">
            <StackPanel IsVisible="{Binding HasSelectedRepository}">
              <TextBlock Classes="bold" Text="{Binding SelectedRepository.Name}"/>
              <TextBlock Classes="small"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{Binding SelectedRepository.Path}"
                         TextWrapping="Wrap"/>

              <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                <TextBlock Foreground="{DynamicResource Brush.FG2}" Text="Estimated:"/>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedRepository.EstimatedBytesText}"/>
              </Grid>

              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Foreground="{DynamicResource Brush.FG2}" Text="Top suspect:"/>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedRepository.TopSuspectDetail}"/>
              </Grid>

              <TextBlock Margin="0,4,0,0"
                         Classes="small"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{Binding SelectedRepository.Notes}"
                         TextWrapping="Wrap"/>

              <TextBlock Margin="0,10,0,4"
                         Classes="bold"
                         Text="Breakdown"/>

              <ItemsControl ItemsSource="{Binding SelectedRepository.Components}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="m:MemoryProfileComponent">
                    <Border Margin="0,0,0,8"
                            Padding="8"
                            Background="{DynamicResource Brush.BG1}"
                            CornerRadius="4">
                      <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Classes="bold" Text="{Binding Name}"/>
                          <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding FormattedBytes}"/>
                        </Grid>
                        <TextBlock Classes="small"
                                   Foreground="{DynamicResource Brush.FG2}"
                                   Text="{Binding Details}"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock IsVisible="{Binding !HasSelectedRepository}"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="No repository is open in the launcher."
                       TextWrapping="Wrap"/>

            <Border Height="1" Background="{DynamicResource Brush.Border2}"/>

            <StackPanel Spacing="8">
              <TextBlock Classes="bold" Text="Shared Caches"/>
              <ItemsControl ItemsSource="{Binding SharedCaches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="m:SharedMemoryProfile">
                    <Border Margin="0,0,0,8"
                            Padding="8"
                            Background="{DynamicResource Brush.BG1}"
                            CornerRadius="4">
                      <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Classes="bold" Text="{Binding Name}"/>
                          <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding FormattedBytes}"/>
                        </Grid>
                        <TextBlock Classes="small"
                                   Foreground="{DynamicResource Brush.FG2}"
                                   Text="{Binding Details}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Classes="small"
                                   Foreground="{DynamicResource Brush.FG2}"
                                   Text="{Binding Notes}"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="8,0,8,8" ColumnDefinitions="Auto,Auto,*">
      <Button Classes="flat"
              Grid.Column="0"
              Content="Refresh"
              Click="OnRefresh"/>

      <Button Classes="flat primary"
              Grid.Column="1"
              Margin="8,0,0,0"
              Content="Collect GC + Refresh"
              Click="OnCollectAndRefresh"/>

      <TextBlock Grid.Column="2"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="Tip: compare repo graph size with the shared avatar cache to see which one is dominating."/>
    </Grid>
  </Grid>
</v:ChromelessWindow>
