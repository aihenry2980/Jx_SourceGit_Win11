{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "config.example.js",
      "**/.*",
      "**/node_modules/**",
      "tools/**",
      "README.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      }
    ]
  }
}
